generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERUSER
  COMPANY_ADMIN
  COMPANY_USER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiagnosticStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum SWOTType {
  STRENGTH
  WEAKNESS
  OPPORTUNITY
  THREAT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Impact {
  LOW
  MEDIUM
  HIGH
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ActionPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CrossType {
  FO
  DO
  FA
  DA
}

enum CrossOrigin {
  USER
  AI
  BOTH
}

enum WeightingLevel {
  MUY_BAJO
  BAJO
  MEDIO
  ALTO
  MUY_ALTO
}

enum CheckyMessageRole {
  USER
  CHECKY
}

enum CheckyFindingBasis {
  FACT
  INFERENCE
}

enum CheckySuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CheckyCategory {
  REVIEW_ASPECTS
  MISSING_CROSSES
  UNRELATED_FACTORS
  STRENGTHEN_STRATEGIES
  STRATEGIC_RISKS
  MISSED_OPPORTUNITIES
  INFO_TO_COMPLEMENT
  NEXT_STEPS
}

/**
 * Fuentes de una estrategia que se pueden ponderar sin ser un cruce. Los cruces siguen pesándose en
 * StrategicCrossWeighting, así que no aparecen aquí a propósito: esta tabla no los reemplaza.
 */
enum StrategySource {
  AI_ANALYSIS
  CHECKY
}

enum ProcessType {
  STRATEGIC
  MISSIONAL
  SUPPORT
}

enum ProcessStatus {
  ACTIVE
  INACTIVE
}

enum ProcessChangeAction {
  CREATED
  UPDATED
}

// Estados documentales de un procedimiento. El flujo de revisión y aprobación obliga a que el
// contenido solo sea editable en DRAFT: una vez aprobado, cualquier cambio exige abrir una nueva
// revisión (APPROVED -> DRAFT), de modo que la versión aprobada queda siempre en el historial y
// jamás se sobrescribe. OBSOLETE es la baja documental (no borra nada).
enum ProcedureStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  OBSOLETE
}

// Acciones del historial append-only de un procedimiento. El conjunto es cerrado: la API no admite
// eventos del cliente, solo los escribe el backend en la misma transacción que la operación.
enum ProcedureHistoryAction {
  CREATED
  UPDATED
  STATUS_CHANGED
}

enum RiskControlEvaluation {
  PENDING
  WEAK
  PARTIAL
  EFFECTIVE
}

enum RiskAcceptanceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RiskTreatmentType {
  AVOID
  MITIGATE
  TRANSFER
  ACCEPT
}

enum RiskCodeCategory {
  ESTRATEGICO
  MISIONAL
  APOYO
}

// Ciclo de aprobación colaborativa de un riesgo. Es un estado de flujo aparte de
// RiskAcceptanceStatus (veredicto formal editable en el formulario): aquí se registra quién
// solicitó, quién decidió, cuándo y con qué comentario, y cada reenvío abre un ciclo nuevo.
// OUTDATED: el riesgo aprobado cambió en campos relevantes y requiere una nueva revisión; la
// decisión anterior se conserva íntegra.
enum RiskApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  OUTDATED
}

/**
 * Tipos de evento del historial auditable de un riesgo. El conjunto es cerrado: la API no admite
 * escritura de eventos desde el cliente, así que solo el backend puede emitir estos valores.
 */
enum RiskAuditEventType {
  RISK_CREATED
  RISK_UPDATED
  CONTROL_CREATED
  CONTROL_UPDATED
  CONTROL_DELETED
  EVIDENCE_CREATED
  EVIDENCE_UPDATED
  EVIDENCE_DELETED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  APPROVAL_OUTDATED
  TICKET_CREATED
  TICKET_STATUS_CHANGED
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sessions       Session[]
  createdTickets Ticket[]  @relation("CreatedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  createdDiagnostics QualityDiagnostic[] @relation("CreatedDiagnostics")
  createdActionPlans  ActionPlan[]       @relation("CreatedActionPlans")
  responsibleItems    ActionItem[]       @relation("ResponsibleActionItems")
  createdCrosses      StrategicCross[]   @relation("CreatedStrategicCrosses")
  createdCheckySessions CheckySession[]  @relation("CreatedCheckySessions")
  createdCrossWeightings StrategicCrossWeighting[] @relation("CreatedCrossWeightings")
  createdStrategyWeightings StrategyWeighting[] @relation("CreatedStrategyWeightings")
  responsibleProcesses Process[] @relation("ResponsibleProcesses")
  riskOwnerRisks Risk[] @relation("RiskOwners")
  mitigationOwnerRisks Risk[] @relation("RiskMitigationOwners")
  riskApprovalRequests RiskApproval[] @relation("RiskApprovalRequesters")
  riskApprovalDecisions RiskApproval[] @relation("RiskApprovalDeciders")
  notifications Notification[]
  evidenceUploads TicketEvidenceFile[] @relation("TicketEvidenceUploaders")
  processChanges  ProcessChange[] @relation("ProcessChangeActors")
  riskAuditEvents RiskAuditEvent[] @relation("RiskAuditActors")
  reportResponsibleKpis Kpi[] @relation("ReportResponsibleKpis")
  monitorResponsibleKpis Kpi[] @relation("MonitorResponsibleKpis")
  responsibleProcedures Procedure[] @relation("ProcedureResponsibles")
  procedureVersions ProcedureVersion[] @relation("ProcedureVersionActors")
  auditLeadAuditors Audit[] @relation("AuditLeadAuditors")
  auditResponsibles Audit[] @relation("AuditResponsibles")
  auditFindingResponsibles AuditFinding[] @relation("AuditFindingResponsibles")
  auditFindingVerifiers AuditFinding[] @relation("AuditFindingVerifiers")
  auditEvents AuditEvent[] @relation("AuditEventActors")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdById String
  assignedToId String?
  actionItemId String?       @unique
  dueDate     DateTime?
  createdBy   User           @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo  User?          @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  actionItem  ActionItem?    @relation(fields: [actionItemId], references: [id], onDelete: SetNull)
  riskApprovals RiskApproval[]
  evidenceFiles TicketEvidenceFile[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
}

/**
 * Evidencia PDF adjunta al ticket de una actividad de mitigación. El archivo vive en disco fuera
 * de cualquier directorio público (EVIDENCE_UPLOAD_DIR) con un nombre aleatorio generado por el
 * servidor: aquí solo se guarda la referencia, nunca la ruta física. `filename` es el nombre
 * original saneado (solo el basename, sin controles ni rutas), `storedName` es el nombre con el
 * que quedó escrito el bytes en disco y `mimeType`/`size` son los valores validados en la subida
 * (extensión .pdf, MIME declarado, firma %PDF real y tope de 10 MB).
 *
 * La baja del ticket borra sus evidencias en cascada (la limpieza física se hace después de
 * confirmar la escritura en base de datos). El uploader queda referenciado con Restrict, igual que
 * Ticket.createdBy: la evidencia nunca pierde a quien la registró.
 */
model TicketEvidenceFile {
  id           String   @id @default(cuid())
  ticketId     String
  filename     String
  storedName   String   @unique
  mimeType     String
  size         Int
  uploadedById String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("TicketEvidenceUploaders", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@index([uploadedById])
}

model Company {
  id             String   @id @default(cuid())
  name           String
  identification String   @unique
  industry       String
  description    String
  users          User[]
  diagnostics    QualityDiagnostic[]
  processes      Process[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

model QualityDiagnostic {
  id             String           @id @default(cuid())
  companyId      String
  title          String
  description    String
  status         DiagnosticStatus @default(DRAFT)
  createdById    String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("CreatedDiagnostics", fields: [createdById], references: [id], onDelete: Restrict)
  swotAnalysis   SWOTAnalysis?
  aiAnalysis     AIAnalysis?
  recommendations Recommendation[]
  actionPlans    ActionPlan[]
  crosses        StrategicCross[]
  strategyWeightings StrategyWeighting[]
  checkySessions CheckySession[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([companyId])
  @@index([createdById])
  @@index([status])
}

model SWOTAnalysis {
  id           String           @id @default(cuid())
  diagnosticId String           @unique
  diagnostic   QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  items        SWOTItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model SWOTItem {
  id          String     @id @default(cuid())
  swotId      String
  type        SWOTType
  description String
  priority    Priority?
  impact      Impact?
  swot        SWOTAnalysis @relation(fields: [swotId], references: [id], onDelete: Cascade)
  factor1Crosses StrategicCross[] @relation("CrossFactor1")
  factor2Crosses StrategicCross[] @relation("CrossFactor2")
  createdAt   DateTime   @default(now())

  @@index([swotId])
  @@index([type])
}

model AIAnalysis {
  id                    String           @id @default(cuid())
  diagnosticId          String           @unique
  executiveSummary      String
  diagnosis             String
  keyFindings           Json
  foStrategies          Json
  doStrategies          Json
  faStrategies          Json
  daStrategies          Json
  priorityRisks         Json
  priorityOpportunities Json
  recommendations       Json
  /// Huella de los factores DOFA con los que se generó esta lectura. Es lo que permite distinguir una
  /// lectura vigente de otra que quedó atrás porque el usuario editó o eliminó factores después: la
  /// matriz DOFA es la fuente de verdad. Va en null en los análisis anteriores a esta columna, y un
  /// null no se puede comparar con nada, así que se trata como desactualizado en lugar de dar por
  /// bueno un análisis del que nadie sabe qué versión de la matriz leyó.
  swotFingerprint       String?
  diagnostic            QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model Recommendation {
  id             String              @id @default(cuid())
  diagnosticId   String
  title          String
  description    String
  priority       Priority
  expectedImpact String
  suggestedAction String
  status         RecommendationStatus @default(PENDING)
  diagnostic     QualityDiagnostic    @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  actionItems    ActionItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([diagnosticId])
  @@index([status])
}

model ActionPlan {
  id             String            @id @default(cuid())
  diagnosticId   String
  title          String
  description    String
  status         ActionPlanStatus  @default(DRAFT)
  createdById    String
  strategySource String?
  strategySourceRef String?
  strategyTitle String?
  strategyDescription String?
  /**
   * Riesgo cuyo plan de mitigación ejecuta este plan de acción. Nullable y sin unicidad: un plan
   * puede existir sin estar vinculado (los planes de análisis estratégico, p. ej.) y un riesgo puede
   * acumular varios planes. El plan sobrevive a la baja del riesgo (SetNull), igual que el resto de
   * los enlaces débiles del proyecto: el diagnóstico al que pertenece no se toca.
   */
  riskId         String?
  diagnostic     QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("CreatedActionPlans", fields: [createdById], references: [id], onDelete: Restrict)
  risk           Risk?             @relation(fields: [riskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items          ActionItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([diagnosticId])
  @@index([createdById])
  @@index([status])
  @@index([riskId])
  @@unique([diagnosticId, strategySource, strategySourceRef])
}

model ActionItem {
  id               String            @id @default(cuid())
  actionPlanId     String
  recommendationId String?
  title            String
  description      String
  priority         Priority
  status           ActionItemStatus  @default(PENDING)
  responsibleId    String?
  dueDate          DateTime?
  actionPlan       ActionPlan        @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  recommendation   Recommendation?   @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  responsible      User?             @relation("ResponsibleActionItems", fields: [responsibleId], references: [id], onDelete: SetNull)
  ticket           Ticket?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([actionPlanId])
  @@index([recommendationId])
  @@index([responsibleId])
  @@index([status])
}

model StrategicCross {
  id           String            @id @default(cuid())
  diagnosticId String
  crossType    CrossType
  origin       CrossOrigin       @default(USER)
  factor1Id    String
  factor2Id    String
  strategy     String?
  /**
   * Decisión tomada sobre la estrategia de este cruce en la pantalla de Checky. Reutiliza el mismo
   * enum que las sugerencias: null significa que todavía no se ha decidido, ACCEPTED es lo que
   * habilita la estrategia en Ponderación y REJECTED la deja fuera. Vive en el cruce y no en una
   * tabla nueva porque el cruce ya es la fuente de verdad de la pareja DOFA y de su estrategia.
   */
  strategyStatus CheckySuggestionStatus?
  aiAnalysis   Json?
  priority     Priority?
  createdById  String
  diagnostic   QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  factor1      SWOTItem          @relation("CrossFactor1", fields: [factor1Id], references: [id], onDelete: Cascade)
  factor2      SWOTItem          @relation("CrossFactor2", fields: [factor2Id], references: [id], onDelete: Cascade)
  createdBy    User              @relation("CreatedStrategicCrosses", fields: [createdById], references: [id], onDelete: Restrict)
  weighting    StrategicCrossWeighting?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([diagnosticId])
  @@index([factor1Id])
  @@index([factor2Id])
  @@unique([factor1Id, factor2Id])
}

model StrategicCrossWeighting {
  id                  String        @id @default(cuid())
  crossId             String        @unique
  impactoEstrategico  WeightingLevel
  viabilidad          WeightingLevel
  urgencia            WeightingLevel
  sinergiaInterna      WeightingLevel
  impactoReputacional WeightingLevel
  weightedScore       Float
  cross               StrategicCross @relation(fields: [crossId], references: [id], onDelete: Cascade)
  createdById         String
  createdBy           User          @relation("CreatedCrossWeightings", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([weightedScore])
  @@index([createdById])
}

/**
 * Ponderación de una estrategia que no es un cruce. La estrategia sigue viviendo donde nació —el
 * análisis con IA o una sugerencia aceptada de Checky— y aquí solo se guarda el valor que le dio el
 * usuario. sourceRef es el hash del texto normalizado, nunca un índice de posición, para que la
 * misma estrategia conserve su ponderación aunque cambie de fila dentro de la IA o de Checky.
 */
model StrategyWeighting {
  id                  String         @id @default(cuid())
  diagnosticId        String
  source              StrategySource
  sourceRef           String
  impactoEstrategico  WeightingLevel
  viabilidad          WeightingLevel
  urgencia            WeightingLevel
  sinergiaInterna      WeightingLevel
  impactoReputacional WeightingLevel
  weightedScore       Float
  createdById         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  diagnostic          QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  createdBy           User               @relation("CreatedStrategyWeightings", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([diagnosticId, source, sourceRef])
  @@index([diagnosticId, weightedScore])
  @@index([createdById])
}

model CheckySession {
  id           String            @id @default(cuid())
  diagnosticId String
  title        String?
  diagnostic   QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  messages     CheckyMessage[]
  createdById  String
  createdBy    User              @relation("CreatedCheckySessions", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([diagnosticId])
  @@index([createdById])
}

model CheckyMessage {
  id                 String                 @id @default(cuid())
  sessionId          String
  role               CheckyMessageRole
  content            String
  category           CheckyCategory?
  basis              CheckyFindingBasis?
  evidenceIds        String[]               @default([])
  insufficientData   Boolean                @default(false)
  missingInformation String[]               @default([])
  status             CheckySuggestionStatus?
  decisionNote       String?
  suggestedStrategyTitle       String?
  suggestedStrategyDescription String?
  session            CheckySession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt          DateTime               @default(now())

  @@index([sessionId])
  @@index([status])
}

model Process {
  id            String        @id @default(cuid())
  companyId     String
  name          String
  code          String?
  type          ProcessType
  version       String?
  frequency     String?
  organizationalArea String?
  supervision   String?
  executionType String?
  objective     String
  description   String?
  responsibleId String?
  status        ProcessStatus @default(ACTIVE)
  thirdPartyProvided Boolean @default(false)
  critical      Boolean       @default(false)
  affectsAccounting Boolean    @default(false)
  personalData  Boolean       @default(false)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responsible   User?         @relation("ResponsibleProcesses", fields: [responsibleId], references: [id], onDelete: SetNull)
  changeHistory ProcessChange[]
  kpis          Kpi[]
  sipocSuppliers SipocSupplier[]
  sipocInputs    SipocInput[]
  sipocProcesses SipocProcess[]
  sipocOutputs   SipocOutput[]
  sipocCustomers SipocCustomer[]
  risks          Risk[]
  procedures     Procedure[]
  audits         Audit[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([type])
  @@index([responsibleId])
}

model ProcessChange {
  id          String             @id @default(cuid())
  processId   String
  processName String
  version     String
  action      ProcessChangeAction
  changedById String?
  changes     Json
  changedAt   DateTime           @default(now())
  changedByName  String?
  changedByEmail String?
  process     Process            @relation(fields: [processId], references: [id], onDelete: Restrict)
  changedBy   User?              @relation("ProcessChangeActors", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([processId, changedAt])
  @@index([changedById])
}

/**
 * Indicador de un proceso. La empresa se obtiene de process.companyId para evitar duplicar el
 * tenant en dos columnas que podrían divergir; la API la devuelve como parte de la vista del KPI.
 */
model Kpi {
  id                   String   @id @default(cuid())
  processId            String
  name                 String
  description          String
  frequency            String
  target               String
  formula              String
  dataSource           String
  unit                 String
  reportResponsibleId  String?
  monitorResponsibleId String?
  greenThreshold       String?
  yellowThreshold      String?
  redThreshold         String?
  process              Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  reportResponsible    User?    @relation("ReportResponsibleKpis", fields: [reportResponsibleId], references: [id], onDelete: SetNull)
  monitorResponsible   User?    @relation("MonitorResponsibleKpis", fields: [monitorResponsibleId], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([processId])
  @@index([reportResponsibleId])
  @@index([monitorResponsibleId])
}

/**
 * Procedimiento documental de un proceso. La empresa se obtiene de process.companyId, igual que en
 * Kpi: no se duplica el tenant en dos columnas que podrían divergir. El código es único dentro del
 * proceso (índice) y la API además lo valida contra toda la empresa antes de crear o renombrar.
 */
model Procedure {
  id            String          @id @default(cuid())
  processId     String
  code          String
  name          String
  objective     String
  scope         String
  description   String?
  responsibleId String?
  status        ProcedureStatus @default(DRAFT)
  version       String          @default("1.0")
  process       Process         @relation(fields: [processId], references: [id], onDelete: Restrict)
  responsible   User?           @relation("ProcedureResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  versions      ProcedureVersion[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([processId, code])
  @@index([processId])
  @@index([status])
  @@index([responsibleId])
}

/**
 * Historial de versiones de un procedimiento, append-only: cada alta, edición o cambio de estado
 * inserta una fila con el snapshot completo del contenido tras el hecho. No existe ningún endpoint
 * que actualice o borre filas (mismo contrato que ProcessChange): así una versión aprobada jamás se
 * sobrescribe y el historial sobrevive a la baja del procedimiento salvo que este nunca se aprobara.
 */
model ProcedureVersion {
  id            String                @id @default(cuid())
  procedureId   String
  version       String
  status        ProcedureStatus
  action        ProcedureHistoryAction
  changes       Json?
  snapshot      Json?
  changedById   String?
  changedByName String?
  changedByEmail String?
  changedAt     DateTime              @default(now())
  procedure     Procedure             @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  changedBy     User?                 @relation("ProcedureVersionActors", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([procedureId, changedAt])
  @@index([changedById])
}

model SipocSupplier {
  id          String   @id @default(cuid())
  processId   String
  description String
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([processId])
}

model SipocInput {
  id          String   @id @default(cuid())
  processId   String
  description String
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([processId])
}

model SipocProcess {
  id          String   @id @default(cuid())
  processId   String
  description String
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([processId])
}

model SipocOutput {
  id          String   @id @default(cuid())
  processId   String
  description String
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([processId])
}

model SipocCustomer {
  id          String   @id @default(cuid())
  processId   String
  description String
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([processId])
}

model Risk {
  id                   String        @id @default(cuid())
  processId            String
  name                 String
  description          String
  riskType             String
  code                 String?       @unique
  bpmnActivity         String
  riskOwnerId          String?
  acceptanceStatus     RiskAcceptanceStatus @default(PENDING)
  treatment            RiskTreatmentType?
  mitigationOwnerId    String?
  // Deprecado: la fecha de inicio del plan ya no se captura ni se expone en la API; la columna
  // se conserva por compatibilidad con los datos existentes (sin migración destructiva).
  mitigationStartDate  DateTime?
  mitigationDueDate    DateTime?
  inherentImpact       Int
  inherentProbability  Int
  residualImpact       Int
  residualProbability  Int
  process              Process       @relation(fields: [processId], references: [id], onDelete: Cascade)
  riskOwner            User?         @relation("RiskOwners", fields: [riskOwnerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  mitigationOwner      User?         @relation("RiskMitigationOwners", fields: [mitigationOwnerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  controls             RiskControl[]
  evidences            RiskEvidence[]
  approvals            RiskApproval[]
  auditEvents          RiskAuditEvent[]
  /** Planes de acción que ejecutan el plan de mitigación de este riesgo (pueden ser varios). */
  mitigationPlans      ActionPlan[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([processId])
  @@index([riskOwnerId])
  @@index([mitigationOwnerId])
}

/**
 * Historial cronológico y auditable del ciclo de vida de un riesgo. Solo lectura desde la
 * aplicación: no existe endpoint que modifique o borre filas (append-only), y este modelo no
 * expone mutaciones por PrismaClient en ninguna ruta. `actorName`/`actorEmail` quedan
 * desnormalizados para que el evento sobreviva a la baja del usuario (mismo criterio que
 * ProcessChange); `actorId` es null solo cuando no hay actor de sesión que atribuir.
 * `changes` guarda los before/after por campo (formato de ProcessChange) y `metadata` los datos
 * estructurados minimizados (ids de ciclo/ticket, decisión, comentario): nunca contraseñas,
 * cookies, tokens ni secretos. El historial vive y muere con su riesgo (ON DELETE CASCADE), igual
 * que controles y evidencias: borrar el riesgo elimina también sus eventos.
 */
model RiskAuditEvent {
  id         String            @id @default(cuid())
  riskId     String
  actorId    String?
  actorName  String?
  actorEmail String?
  eventType  RiskAuditEventType
  summary    String
  changes    Json?
  metadata   Json?
  occurredAt DateTime          @default(now())
  risk       Risk              @relation(fields: [riskId], references: [id], onDelete: Cascade)
  actor      User?             @relation("RiskAuditActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([riskId, occurredAt])
  @@index([eventType])
}

// Contador del último código emitido por categoría (bloqueo de fila al incrementar).
model RiskCodeSequence {
  category  RiskCodeCategory @unique
  next      Int              @default(0)
  updatedAt DateTime         @updatedAt
}

model RiskControl {
  id          String                 @id @default(cuid())
  riskId      String
  description String
  evaluation  RiskControlEvaluation  @default(PENDING)
  risk        Risk                   @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([riskId])
}

model RiskEvidence {
  id          String   @id @default(cuid())
  riskId      String
  name        String
  description String
  url         String
  risk        Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([riskId])
}

// Ciclo de aprobación de un riesgo por su dueño (o por un autorizado de la empresa). Cada reenvío
// crea una fila nueva, de modo que el historial de decisiones es la lista ordenada de ciclos.
// `openKey` se pone en riskId solo mientras el ciclo está PENDING: la restricción única impide que
// dos ciclos abiertos convivan (Postgres admite varios NULL en columnas únicas) y se limpia al
// decidir para poder reenviar después. `ticketId` es único igual que Ticket.actionItemId: un ciclo
// aprobado genera como mucho un ticket, y un reintento nunca duplica la conversión.
model RiskApproval {
  id            String             @id @default(cuid())
  riskId        String
  risk          Risk               @relation(fields: [riskId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User               @relation("RiskApprovalRequesters", fields: [requestedById], references: [id], onDelete: Restrict)
  status        RiskApprovalStatus @default(PENDING)
  openKey       String?            @unique
  decidedById   String?
  decidedBy     User?              @relation("RiskApprovalDeciders", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  comment       String?
  ticketId      String?            @unique
  ticket        Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([riskId])
  @@index([requestedById])
  @@index([status])
}

// Notificación in-app persistente (no hay canales externos): el `link` apunta a la sección de la
// aplicación que debe abrirse (p. ej. "approvals/<id>") y `readAt` marca la lectura individual.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
}

// ---- Módulo Auditorías de calidad (Trazabilidad y Control / Seguimiento y evidencia) ----
// No confundir con RiskAuditEvent (auditoría del sistema del ciclo de vida de un riesgo): aquí se
// planifican y ejecutan auditorías de calidad sobre un proceso, con hallazgos, evidencias y un
// historial propio append-only. La empresa se deriva de process.companyId (mismo criterio que
// Procedure y Kpi): no se duplica el tenant en una columna que podría divergir. El código automático
// es único dentro de la empresa y lo genera el backend con advisory lock (patrón de Process.code);
// no usa RiskCodeSequence.

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum AuditFindingType {
  NONCONFORMITY
  OBSERVATION
  OPPORTUNITY
}

enum AuditFindingSeverity {
  CRITICAL
  MAJOR
  MINOR
}

enum AuditFindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  VERIFIED
}

/**
 * Tipos de evento del historial auditable de una auditoría de calidad. El conjunto es cerrado: la
 * API no admite escritura de eventos desde el cliente, así que solo el backend puede emitirlos
 * (mismo contrato que RiskAuditEventType y ProcedureHistoryAction).
 */
enum AuditEventType {
  AUDIT_CREATED
  AUDIT_UPDATED
  STATUS_CHANGED
  FINDING_CREATED
  FINDING_UPDATED
  FINDING_STATUS_CHANGED
  FINDING_DELETED
  EVIDENCE_CREATED
  EVIDENCE_UPDATED
  EVIDENCE_DELETED
}

model Audit {
  id            String      @id @default(cuid())
  processId     String
  code          String
  title         String
  auditType     String?
  scope         String
  objectives    String?
  criteria      String
  status        AuditStatus @default(PLANNED)
  plannedDate   DateTime?
  startDate     DateTime?
  endDate       DateTime?
  summary       String?
  leadAuditorId String?
  responsibleId String?
  process       Process     @relation(fields: [processId], references: [id], onDelete: Restrict)
  leadAuditor   User?       @relation("AuditLeadAuditors", fields: [leadAuditorId], references: [id], onDelete: SetNull)
  responsible   User?       @relation("AuditResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  findings      AuditFinding[]
  evidences     AuditEvidence[]
  events        AuditEvent[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([processId, code])
  @@index([processId])
  @@index([status])
  @@index([leadAuditorId])
  @@index([responsibleId])
}

model AuditFinding {
  id             String              @id @default(cuid())
  auditId        String
  title          String
  description    String
  type           AuditFindingType
  severity       AuditFindingSeverity
  status         AuditFindingStatus  @default(OPEN)
  dueDate        DateTime?
  responsibleId  String?
  resolution     String?
  verifiedById   String?
  verifiedAt     DateTime?
  audit          Audit               @relation(fields: [auditId], references: [id], onDelete: Cascade)
  responsible    User?               @relation("AuditFindingResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  verifiedBy     User?               @relation("AuditFindingVerifiers", fields: [verifiedById], references: [id], onDelete: SetNull)
  evidences      AuditEvidence[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([auditId])
  @@index([status])
  @@index([severity])
  @@index([responsibleId])
}

// Evidencia con solo enlace http(s) (mismo contrato que RiskEvidence): no se guardan archivos ni
// rutas del servidor. Puede pertenecer a la auditoría completa o anclarse a un hallazgo concreto;
// la ruta valida que el hallazgo sea de esta misma auditoría (sin referencias cruzadas entre
// empresas o auditorías). Si el hallazgo se borra, la evidencia sobrevive anclada a la auditoría.
model AuditEvidence {
  id          String        @id @default(cuid())
  auditId     String
  findingId   String?
  name        String
  description String
  url         String
  audit       Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  finding     AuditFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([auditId])
  @@index([findingId])
}

/**
 * Historial cronológico y auditable del ciclo de vida de una auditoría de calidad. Solo lectura
 * desde la aplicación: no existe endpoint que modifique o borre filas (append-only), y este modelo
 * no expone mutaciones por PrismaClient en ninguna ruta. `actorName`/`actorEmail` quedan
 * desnormalizados para que el evento sobreviva a la baja del usuario (mismo criterio que
 * ProcessChange y RiskAuditEvent); `actorId` es null solo cuando no hay actor de sesión que
 * atribuir. `changes` guarda los before/after por campo (formato ProcessChangeItem) y `metadata`
 * los datos estructurados minimizados: nunca contraseñas, cookies, tokens ni secretos. El historial
 * vive y muere con su auditoría (ON DELETE CASCADE), igual que hallazgos y evidencias.
 */
model AuditEvent {
  id         String         @id @default(cuid())
  auditId    String
  actorId    String?
  actorName  String?
  actorEmail String?
  eventType  AuditEventType
  summary    String
  changes    Json?
  metadata   Json?
  occurredAt DateTime       @default(now())
  audit      Audit          @relation(fields: [auditId], references: [id], onDelete: Cascade)
  actor      User?          @relation("AuditEventActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([auditId, occurredAt])
  @@index([eventType])
}
