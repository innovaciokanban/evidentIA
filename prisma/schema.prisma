  assignedTickets                                Ticket[]                              @relation("AssignedTickets")
  ticketAuditEvents                              TicketAuditEvent[]                    @relation("TicketAuditActors")
  ticketDriveReferences                          TicketDriveReference[]                @relation("TicketDriveReferenceCreators")
  createdDiagnostics                             QualityDiagnostic[]                   @relation("CreatedDiagnostics")
  createdActionPlans                             ActionPlan[]                          @relation("CreatedActionPlans")
  responsibleItems                               ActionItem[]                          @relation("ResponsibleActionItems")
  createdCrosses                                 StrategicCross[]                      @relation("CreatedStrategicCrosses")
  createdCheckySessions                          CheckySession[]                       @relation("CreatedCheckySessions")
  createdCrossWeightings                         StrategicCrossWeighting[]             @relation("CreatedCrossWeightings")
  createdStrategyWeightings                      StrategyWeighting[]                   @relation("CreatedStrategyWeightings")
  responsibleProcesses                           Process[]                             @relation("ResponsibleProcesses")
  riskOwnerRisks                                 Risk[]                                @relation("RiskOwners")
  mitigationOwnerRisks                           Risk[]                                @relation("RiskMitigationOwners")
  riskApprovalRequests                           RiskApproval[]                        @relation("RiskApprovalRequesters")
  riskApprovalDecisions                          RiskApproval[]                        @relation("RiskApprovalDeciders")
  ticketAssignmentRequests                       TicketAssignmentApproval[]            @relation("TicketAssignmentRequests")
  ticketAssignmentCandidates                     TicketAssignmentApproval[]            @relation("TicketAssignmentCandidates")
  previousTicketAssignees                        TicketAssignmentApproval[]            @relation("PreviousTicketAssignees")
  ticketAssignmentDecisions                      TicketAssignmentApproval[]            @relation("TicketAssignmentDecisions")
  notifications                                  Notification[]
  evidenceUploads                                TicketEvidenceFile[]                  @relation("TicketEvidenceUploaders")
  processChanges                                 ProcessChange[]                       @relation("ProcessChangeActors")
  riskAuditEvents                                RiskAuditEvent[]                      @relation("RiskAuditActors")
  reportResponsibleKpis                          Kpi[]                                 @relation("ReportResponsibleKpis")
  monitorResponsibleKpis                         Kpi[]                                 @relation("MonitorResponsibleKpis")
  reportResponsibleProcessIndicators             ProcessIndicator[]                    @relation("ReportResponsibleProcessIndicators")
  monitorResponsibleProcessIndicators            ProcessIndicator[]                    @relation("MonitorResponsibleProcessIndicators")
  reportResponsibleProcedureIndicators           ProcedureIndicator[]                  @relation("ReportResponsibleProcedureIndicators")
  monitorResponsibleProcedureIndicators          ProcedureIndicator[]                  @relation("MonitorResponsibleProcedureIndicators")
  reportResponsibleStrategicObjectiveIndicators  StrategicObjectiveIndicator[]         @relation("ReportResponsibleStrategicObjectiveIndicators")
  monitorResponsibleStrategicObjectiveIndicators StrategicObjectiveIndicator[]         @relation("MonitorResponsibleStrategicObjectiveIndicators")
  responsibleProcedures                          Procedure[]                           @relation("ProcedureResponsibles")
  procedureStepResponsibles                      ProcedureStepResponsible[]
  procedureVersions                              ProcedureVersion[]                    @relation("ProcedureVersionActors")
  auditLeadAuditors                              Audit[]                               @relation("AuditLeadAuditors")
  auditResponsibles                              Audit[]                               @relation("AuditResponsibles")
  auditProgramResponsibles                       AuditProgram[]                        @relation("AuditProgramResponsibles")
  auditProgramProcessPriorityEvaluations         AuditProgramProcessPriority[]         @relation("AuditProgramProcessPriorityEvaluators")
  auditFindingResponsibles                       AuditFinding[]                        @relation("AuditFindingResponsibles")
  auditFindingVerifiers                          AuditFinding[]                        @relation("AuditFindingVerifiers")
  auditFindingEfficacyVerifiers                  AuditFinding[]                        @relation("AuditFindingEfficacyVerifiers")
  auditEvents                                    AuditEvent[]                          @relation("AuditEventActors")
  auditActionResponsibles                        AuditCorrectiveAction[]               @relation("AuditActionResponsibles")
  auditActionProgressCreators                    AuditActionProgress[]                 @relation("AuditActionProgressCreators")
  createdAuditActionAcceptanceCriteria           AuditActionAcceptanceCriterion[]      @relation("AuditActionAcceptanceCriterionCreators")
  completedAuditActionAcceptanceCriteria         AuditActionAcceptanceCriterion[]      @relation("AuditActionAcceptanceCriterionCompleters")
  responsibleAuditEfficacyEvaluations            AuditEfficacyEvaluation[]             @relation("AuditEfficacyEvaluationResponsibles")
  createdAuditEfficacyEvaluations                AuditEfficacyEvaluation[]             @relation("AuditEfficacyEvaluationCreators")
  completedAuditEfficacyEvaluations              AuditEfficacyEvaluation[]             @relation("AuditEfficacyEvaluationCompleters")
  evaluatedAuditEfficacyCriteria                 AuditEfficacyCriterionResult[]        @relation("AuditEfficacyCriterionEvaluators")
  createdAuditEfficacyProgress                   AuditEfficacyEvaluationProgress[]     @relation("AuditEfficacyProgressCreators")
  linkedAuditEfficacyEvidence                    AuditEfficacyEvaluationEvidence[]     @relation("AuditEfficacyEvidenceLinkers")
