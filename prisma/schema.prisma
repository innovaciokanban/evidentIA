  CHECKY_SUGGESTION_ACCEPTED
  CHECKY_SUGGESTION_REJECTED
  TEAM_MEMBER_ASSIGNED
  TEAM_MEMBER_UPDATED
  TEAM_MEMBER_REMOVED
  INDEPENDENCE_EVALUATED
  AUDIT_PLAN_CREATED
  AUDIT_PLAN_UPDATED
  AUDIT_PLAN_STATUS_CHANGED
  AUDIT_PLAN_ACTIVITY_CREATED
  AUDIT_PLAN_ACTIVITY_UPDATED
  AUDIT_PLAN_ACTIVITY_DELETED
  AUDIT_PLAN_ACTIVITY_EXECUTION_STARTED
  AUDIT_PLAN_ACTIVITY_EXECUTION_UPDATED
