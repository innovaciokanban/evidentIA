}

enum AuditTeamRole {
  LEAD
  MEMBER
}

enum AuditIndependenceStatus {
  PENDING
  CLEAR
  CONFLICT
  MITIGATED
}

enum AuditPlanStatus {
  DRAFT
  READY
  APPROVED
  CANCELLED
}

enum AuditPlanActivityType {
  OPENING_MEETING
  DOCUMENT_REVIEW
  INTERVIEW
  PROCESS_REVIEW
  CLOSING_MEETING
  OTHER
}

enum AuditPlanActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditActivityResult {
  SATISFACTORY
  PARTIAL
  ISSUE
  NOT_APPLICABLE
}

model AuditProgram {
  id                String                        @id @default(cuid())
  companyId         String
  code              String
  name              String
  objective         String
  scope             String
  startDate         DateTime
  endDate           DateTime
  responsibleId     String?
  criteria          String
  resources         String?
  risks             String?
  notes             String?
  status            AuditProgramStatus            @default(DRAFT)
  company           Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responsible       User?                         @relation("AuditProgramResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  audits            Audit[]
  processPriorities AuditProgramProcessPriority[]
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([responsibleId])
}

model AuditProgramProcessPriority {
  id                         String       @id @default(cuid())
  auditProgramId             String
  processId                  String
  criticality                Int
  recentChanges              Int
  previousUnfavorableResults Int
  score                      Int
  calculatedPriority         Priority
  manualPriority             Priority?
  manualJustification        String?
  observations               String?
  evaluatedById              String
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  auditProgram               AuditProgram @relation(fields: [auditProgramId], references: [id], onDelete: Cascade)
  process                    Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  evaluatedBy                User         @relation("AuditProgramProcessPriorityEvaluators", fields: [evaluatedById], references: [id], onDelete: Restrict)

  @@unique([auditProgramId, processId])
  @@index([auditProgramId, calculatedPriority])
  @@index([auditProgramId, score])
  @@index([processId])
  @@index([evaluatedById])
}

model Audit {
  id                         String                     @id @default(cuid())
  processId                  String
  auditProgramId             String?
  code                       String
  title                      String
  auditType                  String?
  scope                      String
  objectives                 String?
  criteria                   String
  status                     AuditStatus                @default(PLANNED)
  plannedDate                DateTime?
  startDate                  DateTime?
  endDate                    DateTime?
  summary                    String?
  driveFolderId              String?                    @unique
  storageDeletionRequestedAt DateTime?
  leadAuditorId              String?
  responsibleId              String?
  process                    Process                    @relation(fields: [processId], references: [id], onDelete: Restrict)
  auditProgram               AuditProgram?              @relation(fields: [auditProgramId], references: [id], onDelete: SetNull)
  leadAuditor                User?                      @relation("AuditLeadAuditors", fields: [leadAuditorId], references: [id], onDelete: SetNull)
  responsible                User?                      @relation("AuditResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  findings                   AuditFinding[]
  checkySuggestions          AuditCheckySuggestion[]
  efficacyEvaluations        AuditEfficacyEvaluation[]
  evidences                  AuditEvidence[]
  evidenceFiles              AuditEvidenceFile[]
  events                     AuditEvent[]
  checklists                 AuditChecklist[]
  relatedProcesses           AuditProcess[]
  procedures                 AuditProcedure[]
  teamMembers                AuditTeamMember[]
  plan                       AuditPlan?
  report                     AuditReport?
  followUp                   AuditFollowUp?
  storageOperations          EvidenceStorageOperation[]
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  @@unique([processId, code])
  @@index([processId])
  @@index([auditProgramId])
  @@index([status])
  @@index([leadAuditorId])
  @@index([responsibleId])
}

model AuditReport {
  id                String                 @id @default(cuid())
  auditId           String                 @unique
  status            AuditReportStatus      @default(DRAFT)
  draftSnapshot     Json
  createdById       String
  reviewedById      String?
  reviewedAt        DateTime?
  approvedVersionId String?                @unique
  audit             Audit                  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  createdBy         User                   @relation("AuditReportCreators", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy        User?                  @relation("AuditReportReviewers", fields: [reviewedById], references: [id], onDelete: SetNull)
  versions          AuditReportVersion[]   @relation("AuditReportVersions")
  approvedVersion   AuditReportVersion?    @relation("AuditReportApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([reviewedById])
}

model AuditReportVersion {
  id                String             @id @default(cuid())
  reportId          String
  version           Int
  snapshot          Json
  snapshotHash      String
  approvedById      String
  approvedAt        DateTime           @default(now())
  pdfEvidenceFileId String?            @unique
  report            AuditReport        @relation("AuditReportVersions", fields: [reportId], references: [id], onDelete: Cascade)
  approvedForReport AuditReport?       @relation("AuditReportApprovedVersion")
  approvedBy        User               @relation("AuditReportVersionApprovers", fields: [approvedById], references: [id], onDelete: Restrict)
  pdfEvidenceFile   AuditEvidenceFile? @relation("AuditReportVersionPdf", fields: [pdfEvidenceFileId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())

  @@unique([reportId, version])
  @@index([reportId, approvedAt])
  @@index([approvedById])
}

model AuditFollowUp {
  id            String              @id @default(cuid())
  auditId       String              @unique
  status        AuditFollowUpStatus @default(ENABLED)
  scope         String
  responsibleId String
  enabledById   String
  enabledAt     DateTime            @default(now())
  completedById String?
  completedAt   DateTime?
  notes         String?
  audit         Audit               @relation(fields: [auditId], references: [id], onDelete: Cascade)
  responsible   User                @relation("AuditFollowUpResponsibles", fields: [responsibleId], references: [id], onDelete: Restrict)
  enabledBy     User                @relation("AuditFollowUpEnablers", fields: [enabledById], references: [id], onDelete: Restrict)
  completedBy   User?               @relation("AuditFollowUpCompleters", fields: [completedById], references: [id], onDelete: SetNull)
  actions       AuditCorrectiveAction[]
  evaluations   AuditEfficacyEvaluation[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status])
  @@index([responsibleId, status])
  @@index([enabledById])
  @@index([completedById])
}

/**
 * Asignacion historica de un auditor del banco a una auditoria. Las bajas son logicas para que
 * ninguna operacion posterior borre la trazabilidad de la asignacion o de su evaluacion.
 */
model AuditTeamMember {
  id                        String                     @id @default(cuid())
  auditId                   String
  auditorId                 String
  companyId                 String
  role                      AuditTeamRole              @default(MEMBER)
  assignedAt                DateTime                   @default(now())
  assignedById              String?
  observations              String?
  isActive                  Boolean                    @default(true)
  removedAt                 DateTime?
  removedById               String?
  independenceStatus        AuditIndependenceStatus    @default(PENDING)
  independenceDeclaration   String?
  conflictDescription       String?
  mitigationMeasures        String?
  independenceEvaluatedAt   DateTime?
  independenceEvaluatedById String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  audit                     Audit                      @relation(fields: [auditId], references: [id], onDelete: Restrict)
  auditor                   Auditor                    @relation(fields: [auditorId], references: [id], onDelete: Restrict)
  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignedBy                User?                      @relation("AuditTeamAssignmentActors", fields: [assignedById], references: [id], onDelete: SetNull)
  removedBy                 User?                      @relation("AuditTeamRemovalActors", fields: [removedById], references: [id], onDelete: SetNull)
  independenceEvaluatedBy   User?                      @relation("AuditTeamIndependenceEvaluators", fields: [independenceEvaluatedById], references: [id], onDelete: SetNull)
  activityAssignments       AuditPlanActivityAuditor[]

  @@index([auditId, isActive])
  @@index([auditId, role, isActive])
  @@index([auditorId, isActive])
  @@index([companyId, isActive])
  @@index([assignedById])
  @@index([removedById])
  @@index([independenceEvaluatedById])
}

model AuditPlan {
  id             String              @id @default(cuid())
  auditId        String              @unique
  methodology    String
  samplingMethod String?
  resources      String?
  notes          String?
  status         AuditPlanStatus     @default(DRAFT)
  preparedById   String?
  approvedById   String?
  approvedAt     DateTime?
  audit          Audit               @relation(fields: [auditId], references: [id], onDelete: Cascade)
  preparedBy     User?               @relation("AuditPlanPreparers", fields: [preparedById], references: [id], onDelete: SetNull)
  approvedBy     User?               @relation("AuditPlanApprovers", fields: [approvedById], references: [id], onDelete: SetNull)
  activities     AuditPlanActivity[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
  @@index([preparedById])
  @@index([approvedById])
}

model AuditPlanActivityAuditor {
  id                String            @id @default(cuid())
  activityId        String
  auditTeamMemberId String
  assignedAt        DateTime          @default(now())
  assignedById      String?
  isActive          Boolean           @default(true)
  removedAt         DateTime?
  removedById       String?
  activity          AuditPlanActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  auditTeamMember   AuditTeamMember   @relation(fields: [auditTeamMemberId], references: [id], onDelete: Restrict)
  assignedBy        User?             @relation("AuditPlanActivityAuditorAssigners", fields: [assignedById], references: [id], onDelete: SetNull)
  removedBy         User?             @relation("AuditPlanActivityAuditorRemovers", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([activityId, auditTeamMemberId])
  @@index([activityId, isActive])
  @@index([auditTeamMemberId, isActive])
  @@index([assignedById])
  @@index([removedById])
}

model AuditPlanActivity {
  id                    String                           @id @default(cuid())
  auditPlanId           String
  position              Int                              @default(0)
  type                  AuditPlanActivityType            @default(OTHER)
  title                 String
  description           String?
  scheduledStart        DateTime
  scheduledEnd          DateTime
  location              String?
  responsibleId         String?
  processId             String?
  status                AuditPlanActivityStatus          @default(PLANNED)
  notes                 String?
  actualStart           DateTime?
  actualEnd             DateTime?
  executionResult       AuditActivityResult?
  executionObservations String?
  startedById           String?
  completedById         String?
  auditPlan             AuditPlan                        @relation(fields: [auditPlanId], references: [id], onDelete: Cascade)
  responsible           User?                            @relation("AuditPlanActivityResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  process               Process?                         @relation(fields: [processId], references: [id], onDelete: SetNull)
  startedBy             User?                            @relation("AuditPlanActivityStarters", fields: [startedById], references: [id], onDelete: SetNull)
  completedBy           User?                            @relation("AuditPlanActivityCompleters", fields: [completedById], references: [id], onDelete: SetNull)
  auditorAssignments    AuditPlanActivityAuditor[]
  checklistItemLinks    AuditPlanActivityChecklistItem[]
  evidenceLinks         AuditPlanActivityEvidence[]
  evidenceFileLinks     AuditPlanActivityEvidenceFile[]
  findingLinks          AuditPlanActivityFinding[]
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  @@index([auditPlanId, scheduledStart])
  @@index([auditPlanId, status])
  @@index([responsibleId])
  @@index([processId])
  @@index([startedById])
  @@index([completedById])
}

/**
 * Asociaciones historicas entre una actividad ejecutada y recursos del expediente. Las bajas son
 * logicas para que una desvinculacion no destruya la evidencia de que el recurso estuvo asociado.
 * El historial de actor y cambios vive en AuditEvent.
 */
model AuditPlanActivityChecklistItem {
  id         String             @id @default(cuid())
  activityId String
  itemId     String
  isActive   Boolean            @default(true)
  linkedAt   DateTime           @default(now())
  removedAt  DateTime?
  activity   AuditPlanActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  item       AuditChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([activityId, itemId])
  @@index([activityId, isActive])
  @@index([itemId, isActive])
}

model AuditPlanActivityEvidence {
  id         String            @id @default(cuid())
  activityId String
  evidenceId String
  isActive   Boolean           @default(true)
  linkedAt   DateTime          @default(now())
  removedAt  DateTime?
  activity   AuditPlanActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evidence   AuditEvidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([activityId, evidenceId])
  @@index([activityId, isActive])
  @@index([evidenceId, isActive])
}

model AuditPlanActivityEvidenceFile {
  id             String            @id @default(cuid())
  activityId     String
  evidenceFileId String
  isActive       Boolean           @default(true)
  linkedAt       DateTime          @default(now())
  removedAt      DateTime?
  activity       AuditPlanActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evidenceFile   AuditEvidenceFile @relation(fields: [evidenceFileId], references: [id], onDelete: Cascade)

  @@unique([activityId, evidenceFileId])
  @@index([activityId, isActive])
  @@index([evidenceFileId, isActive])
}

model AuditPlanActivityFinding {
  id         String            @id @default(cuid())
  activityId String
  findingId  String
  isActive   Boolean           @default(true)
  linkedAt   DateTime          @default(now())
  removedAt  DateTime?
  activity   AuditPlanActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  finding    AuditFinding      @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([activityId, findingId])
  @@index([activityId, isActive])
  @@index([findingId, isActive])
}

/**
 * Vínculo de una auditoría con un proceso adicional (el proceso principal sigue en Audit.processId,
 * que es el que ancla el código y el tenant). La clave primaria compuesta impide vínculos
 * duplicados; el borrado del proceso o de la auditoría retira el vínculo sin tocar el historial.
 */
model AuditProcess {
  auditId   String
  processId String
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([auditId, processId])
  @@index([processId])
}

/**
 * Vínculo de una auditoría con un procedimiento. El procedimiento se valida contra la empresa del
 * proceso principal de la auditoría en la API; el cascade retira el vínculo si el procedimiento se
 * retira, sin afectar hallazgos ni evidencias (éstos apuntan al procedimiento con SetNull).
 */
model AuditProcedure {
  auditId     String
  procedureId String
  audit       Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([auditId, procedureId])
  @@index([procedureId])
}

enum AuditChecklistResult {
  PENDING
  CONFORM
  NON_CONFORM
  NOT_APPLICABLE
}

/**
 * Lista de verificación de una auditoría. Puede haber varias (p. ej. una por área); el progreso se
 * calcula sobre sus ítems y el cierre de la auditoría exige que ningún ítem obligatorio siga en
 * PENDING. Borrar una lista borra sus ítems, pero los hallazgos que se anclaron a un ítem
 * sobreviven con itemId en null (la trazabilidad del hallazgo no se pierde).
 */
model AuditChecklist {
  id        String               @id @default(cuid())
  auditId   String
  name      String
  audit     Audit                @relation(fields: [auditId], references: [id], onDelete: Cascade)
  items     AuditChecklistItem[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([auditId])
}

/**
 * Ítem de una lista de verificación: descripción, criterio de evaluación, resultado explícito y
 * observaciones. El resultado arranca en PENDING y cada cambio queda registrado en el historial
 * append-only de la auditoría (CHECKLIST_ITEM_*), de modo que la trazabilidad vive en AuditEvent y
 * no en columnas sobrescribibles. Los hallazgos se anclan con SetNull para sobrevivir al
 * reordenamiento o a la baja del ítem.
 */
model AuditChecklistItem {
  id            String                           @id @default(cuid())
  checklistId   String
  position      Int                              @default(0)
  description   String
  criteria      String
  result        AuditChecklistResult             @default(PENDING)
  observations  String?
  required      Boolean                          @default(true)
  checklist     AuditChecklist                   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  findings      AuditFinding[]
  evidenceFiles AuditEvidenceFile[]
  activityLinks AuditPlanActivityChecklistItem[]
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt

  @@index([checklistId])
  @@index([result])
}

model AuditFinding {
  id                         String                       @id @default(cuid())
  auditId                    String
  title                      String
  description                String
  type                       AuditFindingType
  severity                   AuditFindingSeverity
  status                     AuditFindingStatus           @default(OPEN)
  dueDate                    DateTime?
  responsibleId              String?
  resolution                 String?
  verifiedById               String?
  verifiedAt                 DateTime?
  itemId                     String?
  processId                  String?
  procedureId                String?
  efficacyVerification       String?
  efficacyVerifiedById       String?
  efficacyVerifiedAt         DateTime?
  audit                      Audit                        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  responsible                User?                        @relation("AuditFindingResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  verifiedBy                 User?                        @relation("AuditFindingVerifiers", fields: [verifiedById], references: [id], onDelete: SetNull)
  efficacyVerifiedBy         User?                        @relation("AuditFindingEfficacyVerifiers", fields: [efficacyVerifiedById], references: [id], onDelete: SetNull)
  item                       AuditChecklistItem?          @relation(fields: [itemId], references: [id], onDelete: SetNull)
  process                    Process?                     @relation(fields: [processId], references: [id], onDelete: SetNull)
  procedure                  Procedure?                   @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  evidences                  AuditEvidence[]
  evidenceFiles              AuditEvidenceFile[]
  actions                    AuditCorrectiveAction[]
  immediateCorrections       AuditImmediateCorrection[]
  rootCauseAnalyses          AuditRootCauseAnalysis[]
  correctiveActionCauseLinks AuditCorrectiveActionCause[]
  efficacyEvaluations        AuditEfficacyEvaluation[]
  checkySuggestions          AuditCheckySuggestion[]
  activityLinks              AuditPlanActivityFinding[]
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  @@index([auditId])
  @@index([status])
  @@index([severity])
  @@index([responsibleId])
  @@index([itemId])
  @@index([processId])
  @@index([procedureId])
}

/**
 * Propuesta persistente de Checky para un hallazgo. El documento original nunca cambia y el
 * editable contiene la última versión revisada por la persona. La aceptación es la única ruta que
 * puede crear el registro oficial referenciado por accepted*; una propuesta no altera el expediente.
 */
model AuditCheckySuggestion {
  id                  String                    @id @default(cuid())
  auditId             String
  findingId           String
  requestedById       String
  kind                AuditCheckySuggestionKind
  originalPayload     Json
  editablePayload     Json
  evidenceIds         String[]                  @default([])
  dedupeKey           String
  status              CheckySuggestionStatus    @default(PENDING)
  decisionNote        String?
  acceptedRootCauseId String?                   @unique
  acceptedAnalysisId  String?                   @unique
  acceptedActionId    String?                   @unique
  decidedAt           DateTime?
  audit               Audit                     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  finding             AuditFinding              @relation(fields: [findingId], references: [id], onDelete: Cascade)
  requestedBy         User                      @relation("RequestedAuditCheckySuggestions", fields: [requestedById], references: [id], onDelete: Restrict)
  acceptedRootCause   AuditRootCause?           @relation("AcceptedAuditCheckyRootCause", fields: [acceptedRootCauseId], references: [id], onDelete: SetNull)
  acceptedAnalysis    AuditRootCauseAnalysis?   @relation("AcceptedAuditCheckyAnalysis", fields: [acceptedAnalysisId], references: [id], onDelete: SetNull)
  acceptedAction      AuditCorrectiveAction?    @relation("AcceptedAuditCheckyAction", fields: [acceptedActionId], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([auditId, dedupeKey])
  @@index([auditId, findingId, kind, status])
  @@index([requestedById])
}

// Evidencia con solo enlace http(s) (mismo contrato que RiskEvidence): no se guardan archivos ni
// rutas del servidor. Puede pertenecer a la auditoría completa o anclarse a un hallazgo concreto;
// la ruta valida que el hallazgo sea de esta misma auditoría (sin referencias cruzadas entre
// empresas o auditorías). Si el hallazgo se borra, la evidencia sobrevive anclada a la auditoría.
model AuditEvidence {
  id                              String                            @id @default(cuid())
  auditId                         String
  findingId                       String?
  actionId                        String?
  name                            String
  description                     String
  url                             String
  audit                           Audit                             @relation(fields: [auditId], references: [id], onDelete: Cascade)
  finding                         AuditFinding?                     @relation(fields: [findingId], references: [id], onDelete: SetNull)
  action                          AuditCorrectiveAction?            @relation(fields: [actionId], references: [id], onDelete: SetNull)
  efficacyEvaluationEvidenceLinks AuditEfficacyEvaluationEvidence[]
  activityLinks                   AuditPlanActivityEvidence[]
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt

  @@index([auditId])
  @@index([findingId])
  @@index([actionId])
}

/**
 * Historial cronológico y auditable del ciclo de vida de una auditoría de calidad. Solo lectura
 * desde la aplicación: no existe endpoint que modifique o borre filas (append-only), y este modelo
 * no expone mutaciones por PrismaClient en ninguna ruta. `actorName`/`actorEmail` quedan
 * desnormalizados para que el evento sobreviva a la baja del usuario (mismo criterio que
 * ProcessChange y RiskAuditEvent); `actorId` es null solo cuando no hay actor de sesión que
 * atribuir. `changes` guarda los before/after por campo (formato ProcessChangeItem) y `metadata`
 * los datos estructurados minimizados: nunca contraseñas, cookies, tokens ni secretos. El historial
 * vive y muere con su auditoría (ON DELETE CASCADE), igual que hallazgos y evidencias.
 */
model AuditEvent {
  id         String         @id @default(cuid())
  auditId    String
  actorId    String?
  actorName  String?
  actorEmail String?
  eventType  AuditEventType
  summary    String
  changes    Json?
  metadata   Json?
  occurredAt DateTime       @default(now())
  audit      Audit          @relation(fields: [auditId], references: [id], onDelete: Cascade)
  actor      User?          @relation("AuditEventActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([auditId, occurredAt])
  @@index([eventType])
}

enum AuditCorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditCorrectiveActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditActionAcceptanceCriterionType {
  IMPLEMENTATION
  EFFECTIVENESS
}

/**
 * Acción correctiva derivada de un hallazgo de auditoría. `required` determina si su estado
 * bloquea la resolución del hallazgo: ninguna acción obligatoria puede quedar sin estado final
 * (COMPLETED o CANCELLED) para resolver. El historial de avances (AuditActionProgress) es
 * independiente y sobrevive a los cambios de estado; un hallazgo con acciones no se puede borrar
 * (la API responde 409 y el esquema usa Restrict), de modo que la trazabilidad no se destruye.
 */
model AuditCorrectiveAction {
  id                   String                           @id @default(cuid())
  findingId            String
  title                String
  description          String
  objective            String?
  implementationPlan   String?
  resources            String?
  observations         String?
  responsibleId        String?
  priority             AuditCorrectiveActionPriority    @default(MEDIUM)
  status               AuditCorrectiveActionStatus      @default(OPEN)
  required             Boolean                          @default(true)
  evidenceRequired     Boolean                          @default(false)
  followUpId           String?
  followUpReason       AuditFollowUpActionReason?
  followUpJustification String?
  progressPercent      Int                              @default(0)
  workflowVersion      Int                              @default(0)
  dueDate              DateTime?
  completedAt          DateTime?
  finding              AuditFinding                     @relation(fields: [findingId], references: [id], onDelete: Restrict)
  responsible          User?                            @relation("AuditActionResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  progress             AuditActionProgress[]
  acceptanceCriteria   AuditActionAcceptanceCriterion[]
  evidenceFiles        AuditEvidenceFile[]
  evidences            AuditEvidence[]
  causeLinks           AuditCorrectiveActionCause[]     @relation("CorrectiveActionCauseLinks")
  checkySuggestion     AuditCheckySuggestion?           @relation("AcceptedAuditCheckyAction")
  efficacyEvaluations  AuditEfficacyEvaluation[]
  followUp             AuditFollowUp?                   @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  efficacyEvaluationId String?
  efficacyEvaluation   AuditEfficacyEvaluation?         @relation("EfficacyFollowUpActions", fields: [efficacyEvaluationId], references: [id], onDelete: SetNull)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  @@unique([id, findingId])
  @@index([findingId])
  @@index([status])
  @@index([responsibleId])
  @@index([dueDate])
  @@index([followUpId, status])
}

/**
 * Criterio verificable de aceptación de una acción. La categoría EFFECTIVENESS
 * se registra para trazabilidad, pero su evaluación formal sigue perteneciendo
 * al flujo de eficacia del hallazgo y no se automatiza aquí.
 */
model AuditActionAcceptanceCriterion {
  id              String                             @id @default(cuid())
  actionId        String
  type            AuditActionAcceptanceCriterionType @default(IMPLEMENTATION)
  description     String
  expectedResult  String
  required        Boolean                            @default(true)
  isMet           Boolean                            @default(false)
  observations    String?
  completedAt     DateTime?
  completedById   String?
  createdById     String?
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt
  action          AuditCorrectiveAction              @relation(fields: [actionId], references: [id], onDelete: Restrict)
  completedBy     User?                              @relation("AuditActionAcceptanceCriterionCompleters", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy       User?                              @relation("AuditActionAcceptanceCriterionCreators", fields: [createdById], references: [id], onDelete: SetNull)
  efficacyResults AuditEfficacyCriterionResult[]

  @@index([actionId, type, isMet])
  @@index([actionId, required, isMet])
  @@index([completedById])
  @@index([createdById])
}

enum AuditEfficacyEvaluationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditEfficacyOutcome {
  PENDING
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
}

enum AuditEfficacyMethodology {
  DOCUMENTARY_SAMPLING
  INDICATOR_MONITORING
  DIRECT_OBSERVATION
  INTERVIEWS
  RECORD_REVIEW
  FOLLOW_UP_AUDIT
  OTHER
}

/**
 * Historical efficacy evaluation for one completed corrective action. The legacy scalar efficacy
 * fields on AuditFinding remain for compatibility; this model is the structured source for new
 * evaluations and never overwrites a previous evaluation.
 */
model AuditEfficacyEvaluation {
  id                     String                                @id @default(cuid())
  auditId                String
  findingId              String
  actionId               String
  status                 AuditEfficacyEvaluationStatus         @default(PLANNED)
  outcome                AuditEfficacyOutcome                  @default(PENDING)
  responsibleId          String
  scheduledDate          DateTime?
  methodology            AuditEfficacyMethodology
  methodologyOther       String?
  observationPeriod      String?
  observationStartDate   DateTime?
  observationEndDate     DateTime?
  scope                  String
  observations           String?
  conclusion             String?
  recurrenceDetected     Boolean                               @default(false)
  recurrenceDescription  String?
  recurrenceIdentifiedAt DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  completedById          String?
  createdById            String
  followUpId             String?
  audit                  Audit                                 @relation(fields: [auditId], references: [id], onDelete: Cascade)
  finding                AuditFinding                          @relation(fields: [findingId], references: [id], onDelete: Restrict)
  action                 AuditCorrectiveAction                 @relation(fields: [actionId, findingId], references: [id, findingId], onDelete: Restrict)
  responsible            User                                  @relation("AuditEfficacyEvaluationResponsibles", fields: [responsibleId], references: [id], onDelete: Restrict)
  createdBy              User                                  @relation("AuditEfficacyEvaluationCreators", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy            User?                                 @relation("AuditEfficacyEvaluationCompleters", fields: [completedById], references: [id], onDelete: SetNull)
  criteria               AuditEfficacyCriterionResult[]
  progress               AuditEfficacyEvaluationProgress[]
  evidenceLinks          AuditEfficacyEvaluationEvidence[]
  evidenceFileLinks      AuditEfficacyEvaluationEvidenceFile[]
  followUpActions        AuditCorrectiveAction[]               @relation("EfficacyFollowUpActions")
  followUp               AuditFollowUp?                        @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  createdAt              DateTime                              @default(now())
  updatedAt              DateTime                              @updatedAt

  @@index([auditId, createdAt])
  @@index([findingId, createdAt])
  @@index([actionId, createdAt])
  @@index([status])
  @@index([outcome])
  @@index([responsibleId])
  @@index([scheduledDate])
  @@index([followUpId, status])
}

/**
 * Snapshot and measured result for one EFFECTIVENESS criterion in one evaluation.
 */
model AuditEfficacyCriterionResult {
  id              String                         @id @default(cuid())
  evaluationId    String
  criterionId     String
  description     String
  expectedResult  String
  required        Boolean
  resultObtained  String?
  measuredValue   String?
  measurementUnit String?
  sampleSize      Int?
  isMet           Boolean?
  observations    String?
  evaluatedById   String?
  evaluatedAt     DateTime?
  evaluation      AuditEfficacyEvaluation        @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion       AuditActionAcceptanceCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  evaluatedBy     User?                          @relation("AuditEfficacyCriterionEvaluators", fields: [evaluatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
  @@index([evaluatedById])
}

/**
 * Append-only partial work log for an efficacy evaluation.
 */
model AuditEfficacyEvaluationProgress {
  id                String                  @id @default(cuid())
  evaluationId      String
  note              String
  results           String?
  difficulties      String?
  pendingActivities String?
  percent           Int?
  createdById       String?
  evaluation        AuditEfficacyEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  createdBy         User?                   @relation("AuditEfficacyProgressCreators", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())

  @@index([evaluationId, createdAt])
  @@index([createdById])
}

/**
 * Link to an official URL evidence without changing its original audit/action anchor.
 */
model AuditEfficacyEvaluationEvidence {
  id           String                  @id @default(cuid())
  evaluationId String
  evidenceId   String
  linkedById   String?
  linkedAt     DateTime                @default(now())
  evaluation   AuditEfficacyEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evidence     AuditEvidence           @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  linkedBy     User?                   @relation("AuditEfficacyEvidenceLinkers", fields: [linkedById], references: [id], onDelete: SetNull)

  @@unique([evaluationId, evidenceId])
  @@index([evidenceId])
  @@index([linkedById])
}

/**
 * Link to an official PDF evidence without creating a second storage system.
 */
model AuditEfficacyEvaluationEvidenceFile {
  id             String                  @id @default(cuid())
  evaluationId   String
  evidenceFileId String
  linkedById     String?
  linkedAt       DateTime                @default(now())
  evaluation     AuditEfficacyEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evidenceFile   AuditEvidenceFile       @relation(fields: [evidenceFileId], references: [id], onDelete: Restrict)
  linkedBy       User?                   @relation("AuditEfficacyEvidenceFileLinkers", fields: [linkedById], references: [id], onDelete: SetNull)

  @@unique([evaluationId, evidenceFileId])
  @@index([evidenceFileId])
  @@index([linkedById])
}

/**
 * Registro de avance de una acción correctiva (append-only desde el punto de vista del usuario:
 * solo se crean filas, no se editan ni se borran desde la API). El borrado físico solo ocurre en
 * cascada al eliminar la acción, que la API bloquea si ya hay avances registrados.
 */
model AuditActionProgress {
  id          String                @id @default(cuid())
  actionId    String
  note        String
  percent     Int?
  createdById String?
  action      AuditCorrectiveAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("AuditActionProgressCreators", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())

  @@index([actionId, createdAt])
}

/**
 * Correccion inmediata o contencion de un hallazgo. No sustituye a
 * AuditCorrectiveAction: esta entidad trata el efecto inmediato y sus consecuencias,
 * mientras la accion correctiva elimina la causa para evitar la recurrencia.
 */
model AuditImmediateCorrection {
  id                     String                         @id @default(cuid())
  findingId              String
  description            String
  containmentMeasures    String?
  consequencesIdentified String?
  consequencesTreatment  String?
  responsibleId          String?
  plannedDate            DateTime?
  executedAt             DateTime?
  status                 AuditImmediateCorrectionStatus @default(OPEN)
  observations           String?
  createdById            String
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  finding                AuditFinding                   @relation(fields: [findingId], references: [id], onDelete: Restrict)
  responsible            User?                          @relation("AuditImmediateCorrectionResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  createdBy              User                           @relation("AuditImmediateCorrectionCreators", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([findingId, status])
  @@index([responsibleId, status])
  @@index([createdById])
  @@index([plannedDate])
}

/**
 * Una investigacion historica de causas para un hallazgo. Los cambios posteriores deben crear
 * una nueva investigacion cuando la anterior ya fue confirmada; la API futura debe imponer esa
 * regla y registrar sus mutaciones en AuditEvent.
 */
model AuditRootCauseAnalysis {
  id                 String                       @id @default(cuid())
  findingId          String
  methodology        AuditRootCauseAnalysisMethod
  status             AuditRootCauseAnalysisStatus @default(DRAFT)
  origin             AuditRootCauseOrigin         @default(MANUAL)
  problemDescription String
  responsibleId      String?
  createdById        String
  confirmedById      String?
  confirmedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  finding            AuditFinding                 @relation(fields: [findingId], references: [id], onDelete: Restrict)
  responsible        User?                        @relation("AuditRootCauseAnalysisResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  createdBy          User                         @relation("AuditRootCauseAnalysisCreators", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy        User?                        @relation("AuditRootCauseAnalysisConfirmers", fields: [confirmedById], references: [id], onDelete: SetNull)
  causes             AuditRootCause[]
  fiveWhySteps       AuditRootCauseFiveWhyStep[]
  checkySuggestion   AuditCheckySuggestion?       @relation("AcceptedAuditCheckyAnalysis")

  @@unique([id, findingId])
  @@index([findingId, status])
  @@index([findingId, methodology])
  @@index([responsibleId])
  @@index([createdById])
  @@index([confirmedById])
}

/**
 * Causa potencial, confirmada o descartada dentro de una investigacion. La categoria es texto
 * libre para que Ishikawa no quede atado a categorias industriales predeterminadas.
 */
model AuditRootCause {
  id                 String                       @id @default(cuid())
  analysisId         String
  findingId          String
  status             AuditRootCauseStatus         @default(POTENTIAL)
  description        String
  justification      String?
  supportingEvidence String?
  ishikawaCategory   String?
  position           Int                          @default(0)
  createdById        String
  confirmedById      String?
  confirmedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  analysis           AuditRootCauseAnalysis       @relation(fields: [analysisId, findingId], references: [id, findingId], onDelete: Cascade)
  createdBy          User                         @relation("AuditRootCauseCreators", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy        User?                        @relation("AuditRootCauseConfirmers", fields: [confirmedById], references: [id], onDelete: SetNull)
  actionLinks        AuditCorrectiveActionCause[] @relation("RootCauseActionLinks")
  checkySuggestion   AuditCheckySuggestion?       @relation("AcceptedAuditCheckyRootCause")

  @@unique([id, findingId])
  @@index([analysisId, status, position])
  @@index([findingId, status])
  @@index([createdById])
  @@index([confirmedById])
}

/**
 * Paso ordenado de un analisis FIVE_WHYS. No se impone una cantidad fija de pasos: la API futura
 * debe validar que el analisis use esta metodologia antes de aceptar los pasos.
 */
model AuditRootCauseFiveWhyStep {
  id         String                 @id @default(cuid())
  analysisId String
  sequence   Int
  question   String
  answer     String
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  analysis   AuditRootCauseAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId, sequence])
  @@index([analysisId, sequence])
}

/**
 * Vinculo historico entre una accion correctiva existente y una causa del mismo hallazgo. Las
 * claves compuestas hacen que PostgreSQL rechace un vinculo cruzado entre hallazgos distintos.
 */
model AuditCorrectiveActionCause {
  id          String                @id @default(cuid())
  findingId   String
  actionId    String
  causeId     String
  isActive    Boolean               @default(true)
  linkedAt    DateTime              @default(now())
  linkedById  String?
  removedAt   DateTime?
  removedById String?
  finding     AuditFinding          @relation(fields: [findingId], references: [id], onDelete: Restrict)
  action      AuditCorrectiveAction @relation("CorrectiveActionCauseLinks", fields: [actionId, findingId], references: [id, findingId], onDelete: Restrict)
  cause       AuditRootCause        @relation("RootCauseActionLinks", fields: [causeId, findingId], references: [id, findingId], onDelete: Restrict)
  linkedBy    User?                 @relation("AuditCorrectiveActionCauseLinkers", fields: [linkedById], references: [id], onDelete: SetNull)
  removedBy   User?                 @relation("AuditCorrectiveActionCauseRemovers", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([findingId, actionId, causeId])
  @@index([findingId, isActive])
  @@index([actionId, isActive])
  @@index([causeId, isActive])
  @@index([linkedById])
  @@index([removedById])
}

/**
 * Evidencia en PDF adjunta a una auditoría, un hallazgo, una acción correctiva o un ítem de
 * checklist (como mucho uno de ellos; la API lo valida). Las filas antiguas usan el proveedor
 * local y `storedName`; las nuevas pueden usar Google Drive privado y `driveFileId`. La descarga
 * siempre pasa por un endpoint autenticado. Si el hallazgo o la acción se retiran, la evidencia
 * sobrevive anclada a la auditoría (SET NULL) para no perder el respaldo documental.
 */
model AuditEvidenceFile {
  id                                  String                                @id @default(cuid())
  auditId                             String
  findingId                           String?
  actionId                            String?
  itemId                              String?
  filename                            String
  storedName                          String?                               @unique
  mimeType                            String
  size                                Int
  uploadedById                        String
  storageProvider                     EvidenceStorageProvider               @default(LOCAL)
  storageState                        EvidenceStorageState                  @default(PENDING)
  driveFileId                         String?                               @unique
  driveUrl                            String?
  storageError                        String?
  storageErrorCode                    String?
  stagedName                          String?
  lastAttemptAt                       DateTime?
  driveConnectionId                   String?
  audit                               Audit                                 @relation(fields: [auditId], references: [id], onDelete: Cascade)
  finding                             AuditFinding?                         @relation(fields: [findingId], references: [id], onDelete: SetNull)
  action                              AuditCorrectiveAction?                @relation(fields: [actionId], references: [id], onDelete: SetNull)
  efficacyEvaluationEvidenceFileLinks AuditEfficacyEvaluationEvidenceFile[]
  reportVersion                       AuditReportVersion?                  @relation("AuditReportVersionPdf")
  item                                AuditChecklistItem?                   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  activityLinks                       AuditPlanActivityEvidenceFile[]
  uploadedBy                          User                                  @relation("AuditEvidenceUploaders", fields: [uploadedById], references: [id], onDelete: Restrict)
  driveConnection                     CompanyGoogleDriveConnection?         @relation(fields: [driveConnectionId], references: [id], onDelete: Restrict)
  operations                          EvidenceStorageOperation[]
  createdAt                           DateTime                              @default(now())

  @@index([auditId])
  @@index([findingId])
  @@index([actionId])
  @@index([itemId])
  @@index([uploadedById])
}

enum EvidenceStorageProvider {
  LOCAL
  GOOGLE_DRIVE
  R2
}

enum EvidenceStorageState {
  PENDING
  READY
  DELETE_PENDING
  FAILED
}

enum GoogleDriveConnectionStatus {
  CONNECTED
  REAUTH_REQUIRED
  DISCONNECTED
}

enum EvidenceStorageOperationType {
  UPLOAD
  FILE_DELETE
  AUDIT_DELETE
}

enum EvidenceStorageOperationStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  RETRYABLE
  FAILED
  CANCELLED
}

model CompanyGoogleDriveConnection {
  id                    String                      @id @default(cuid())
  companyId             String
  encryptedRefreshToken String
  googleSubject         String?
  googleAccountEmail    String?
  rootFolderId          String?
  scopes                String[]
  status                GoogleDriveConnectionStatus @default(CONNECTED)
  lastRefreshAt         DateTime?
  lastErrorCode         String?
  lastError             String?
  connectedAt           DateTime                    @default(now())
  disconnectedAt        DateTime?
  createdAt             DateTime                    @default(now())
  // The SQL migration also provides a database default for direct inserts; @updatedAt keeps
  // Prisma writes current on updates.
  updatedAt             DateTime                    @default(now()) @updatedAt
  company               Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  evidenceFiles         AuditEvidenceFile[]
  ticketDriveReferences TicketDriveReference[]
  operations            EvidenceStorageOperation[]

  // PostgreSQL-only partial UNIQUE index is maintained in the migration SQL because Prisma
  // cannot express WHERE status = 'CONNECTED' declaratively.
  @@index([companyId, status])
}

model GoogleDriveOAuthState {
  id                String    @id @default(cuid())
  stateHash         String    @unique
  companyId         String
  initiatedById     String
  sessionId         String
  encryptedVerifier String
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  initiatedBy       User      @relation(fields: [initiatedById], references: [id], onDelete: Cascade)
  session           Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([companyId])
  @@index([sessionId])
}

model EvidenceStorageOperation {
  id             String                         @id @default(cuid())
  companyId      String
  auditId        String?
  evidenceFileId String?
  connectionId   String?
  operationType  EvidenceStorageOperationType
  status         EvidenceStorageOperationStatus @default(PENDING)
  idempotencyKey String                         @unique
  remoteFileId   String?
  remoteFolderId String?
  attemptCount   Int                            @default(0)
  nextAttemptAt  DateTime?
  lastAttemptAt  DateTime?
  leaseOwner     String?
  leaseUntil     DateTime?
  lastErrorCode  String?
  lastError      String?
  createdAt      DateTime                       @default(now())
  // The SQL migration also provides a database default for direct inserts; @updatedAt keeps
  // Prisma writes current on updates.
  updatedAt      DateTime                       @default(now()) @updatedAt
  company        Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  audit          Audit?                         @relation(fields: [auditId], references: [id], onDelete: Restrict)
  evidenceFile   AuditEvidenceFile?             @relation(fields: [evidenceFileId], references: [id], onDelete: Restrict)
  connection     CompanyGoogleDriveConnection?  @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
  @@index([companyId, auditId])
  @@index([evidenceFileId])
}

model LearningCourse {
  id          String                  @id @default(cuid())
  companyId   String
  title       String
  description String
  category    String
  status      LearningCourseStatus    @default(DRAFT)
  createdById String
  updatedById String
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User                    @relation("LearningCourseCreators", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User                    @relation("LearningCourseUpdaters", fields: [updatedById], references: [id], onDelete: Restrict)
  enrollments LearningEnrollment[]
  versions    LearningCourseVersion[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([companyId, status])
  @@index([companyId, category])
  @@index([updatedAt])
}

model LearningCourseVersion {
  id            String               @id @default(cuid())
  courseId      String
  versionNumber Int
  status        LearningCourseStatus @default(DRAFT)
  changeSummary String?
  publishedAt   DateTime?
  createdById   String
  updatedById   String
  course        LearningCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy     User                 @relation("LearningVersionCreators", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User                 @relation("LearningVersionUpdaters", fields: [updatedById], references: [id], onDelete: Restrict)
  enrollments   LearningEnrollment[]
  modules       LearningModule[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([courseId, versionNumber])
  @@index([courseId, status])
  @@index([status, publishedAt])
}

model LearningModule {
  id          String                @id @default(cuid())
  versionId   String
  title       String
  description String
  position    Int                   @default(0)
  version     LearningCourseVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  lessons     LearningLesson[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([versionId, position])
}

model LearningLesson {
  id              String             @id @default(cuid())
  moduleId        String
  title           String
  description     String
  type            LearningLessonType @default(TEXT)
  content         String?
  durationMinutes Int?
  position        Int                @default(0)
  module          LearningModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([moduleId, position])
  @@index([type])
}

model LearningEnrollment {
  id           String                @id @default(cuid())
  companyId    String
  courseId     String
  versionId    String
  userId       String
  assignedById String
  assignedAt   DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  course       LearningCourse        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  version      LearningCourseVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  user         User                  @relation("LearningEnrollmentUsers", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User                  @relation("LearningEnrollmentAssigners", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([courseId, userId])
  @@index([companyId, userId])
  @@index([courseId, versionId])
  @@index([userId, assignedAt])
}
