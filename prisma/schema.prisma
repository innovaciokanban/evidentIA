  auditImmediateCorrectionResponsibles           AuditImmediateCorrection[]            @relation("AuditImmediateCorrectionResponsibles")
  createdAuditImmediateCorrections               AuditImmediateCorrection[]            @relation("AuditImmediateCorrectionCreators")
