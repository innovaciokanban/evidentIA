model UserStatusEvent {
  id         String              @id @default(cuid())
  userId     String
  actorId    String?
  eventType  UserStatusEventType
  reason     String?
  actorName  String?
  actorEmail String?
  occurredAt DateTime            @default(now())

  user  User  @relation("UserStatusChanges", fields: [userId], references: [id], onDelete: Restrict)
  actor User? @relation("UserStatusActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([actorId])
}

model Session {
  id                     String                  @id @default(cuid())
  tokenHash              String                  @unique
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleDriveOAuthStates GoogleDriveOAuthState[]
  expiresAt              DateTime
  createdAt              DateTime                @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Ticket {
  id                  String                     @id @default(cuid())
  title               String
  description         String
  status              TicketStatus               @default(OPEN)
  priority            TicketPriority             @default(MEDIUM)
  createdById         String
  assignedToId        String?
  actionItemId        String?                    @unique
  dueDate             DateTime?
  createdBy           User                       @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo          User?                      @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  actionItem          ActionItem?                @relation(fields: [actionItemId], references: [id], onDelete: SetNull)
  riskApprovals       RiskApproval[]
  assignmentApprovals TicketAssignmentApproval[]
  evidenceFiles       TicketEvidenceFile[]
  driveReferences     TicketDriveReference[]
  auditEvents         TicketAuditEvent[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
}

enum TicketAssignmentApprovalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  SUPERSEDED
}

enum TicketAssignmentApprovalSource {
  DIRECT
  RISK_APPROVAL
  ACTION_ITEM
  STRATEGY_TASK
}

/**
 * Solicitud de asignacion separada de la asignacion confirmada en Ticket.assignedToId.
 * Una fila conserva el ciclo completo de solicitud y decision; la auditoria de tickets registra
 * los cambios append-only para que las solicitudes no resueltas tambien sean visibles en historial.
 */
model TicketAssignmentApproval {
  id                 String                         @id @default(cuid())
  ticketId           String?
  requestedById      String
  proposedAssigneeId String
  previousAssigneeId String?
  decidedById        String?
  riskApprovalId     String?                        @unique
  status             TicketAssignmentApprovalStatus @default(PENDING)
  source             TicketAssignmentApprovalSource
  comment            String?
  createdAt          DateTime                       @default(now())
  decidedAt          DateTime?
  updatedAt          DateTime                       @updatedAt

  ticket           Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  requestedBy      User          @relation("TicketAssignmentRequests", fields: [requestedById], references: [id], onDelete: Restrict)
  proposedAssignee User          @relation("TicketAssignmentCandidates", fields: [proposedAssigneeId], references: [id], onDelete: Restrict)
  previousAssignee User?         @relation("PreviousTicketAssignees", fields: [previousAssigneeId], references: [id], onDelete: SetNull)
  decidedBy        User?         @relation("TicketAssignmentDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  riskApproval     RiskApproval? @relation(fields: [riskApprovalId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([ticketId, status])
  @@index([proposedAssigneeId, status])
  @@index([requestedById, status])
  @@index([status])
}

/**
 * Historial cronologico y auditable del ciclo de vida de un ticket. Solo lectura desde la
 * aplicacion: los eventos se escriben unicamente desde las transacciones de negocio y no existe
 * un endpoint que acepte eventos del cliente. Los datos del actor se desnormalizan para que el
 * registro sobreviva a la baja del usuario; changes conserva valores before/after y metadata
 * solo contiene ids o metadatos no sensibles.
 */
model TicketAuditEvent {
  id          String               @id @default(cuid())
  ticketId    String?
  ticketTitle String?
  companyId   String?
  actorId     String?
  actorName   String?
  actorEmail  String?
  eventType   TicketAuditEventType
  summary     String
  changes     Json?
  metadata    Json?
  occurredAt  DateTime             @default(now())
  ticket      Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  actor       User?                @relation("TicketAuditActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([eventType])
}

/**
 * Evidencia PDF adjunta al ticket de una actividad de mitigación. El archivo vive en disco fuera
 * de cualquier directorio público (EVIDENCE_UPLOAD_DIR) con un nombre aleatorio generado por el
 * servidor: aquí solo se guarda la referencia, nunca la ruta física. `filename` es el nombre
 * original saneado (solo el basename, sin controles ni rutas), `storedName` es el nombre con el
 * que quedó escrito el bytes en disco y `mimeType`/`size` son los valores validados en la subida
 * (extensión .pdf, MIME declarado, firma %PDF real y tope de 10 MB).
 * La baja del ticket borra sus evidencias en cascada (la limpieza física se hace después de
 * confirmar la escritura en base de datos). El uploader queda referenciado con Restrict, igual que
 * Ticket.createdBy: la evidencia nunca pierde a quien la registró.
 */
model TicketEvidenceFile {
  id              String                  @id @default(cuid())
  ticketId        String
  filename        String
  storedName      String                  @unique
  storageProvider EvidenceStorageProvider @default(LOCAL)
  mimeType        String
  size            Int
  uploadedById    String
  ticket          Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy      User                    @relation("TicketEvidenceUploaders", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt       DateTime                @default(now())

  @@index([ticketId])
  @@index([uploadedById])
}

/**
 * Referencia a un archivo privado de Google Drive seleccionado con Google Picker. No se copia el
 * archivo ni se modifican sus permisos; la conexión de la empresa se conserva para validar el
 * acceso cuando se registra la referencia. La eliminación solo retira esta fila.
 */
model TicketDriveReference {
  id           String                       @id @default(cuid())
  ticketId     String
  companyId    String
  connectionId String
  driveFileId  String
  filename     String
  mimeType     String
  size         Int?
  driveUrl     String?
  createdById  String
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  ticket       Ticket                       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  company      Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  connection   CompanyGoogleDriveConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  createdBy    User                         @relation("TicketDriveReferenceCreators", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([ticketId, driveFileId])
  @@index([ticketId, createdAt])
  @@index([companyId])
  @@index([connectionId])
  @@index([createdById])
}

model Company {
  id                     String                         @id @default(cuid())
  name                   String
  identification         String                         @unique
  industry               String
  description            String
  driveFolderId          String?                        @unique
  users                  User[]
  diagnostics            QualityDiagnostic[]
  processes              Process[]
  googleDriveConnections CompanyGoogleDriveConnection[]
  ticketDriveReferences  TicketDriveReference[]
  auditPrograms          AuditProgram[]
  googleDriveOAuthStates GoogleDriveOAuthState[]
  storageOperations      EvidenceStorageOperation[]
  learningCourses        LearningCourse[]
  learningEnrollments    LearningEnrollment[]
  auditors               Auditor[]
  auditTeamMembers       AuditTeamMember[]
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  @@index([name])
}

model Auditor {
  id              String              @id @default(cuid())
  companyId       String
  name            String
  email           String
  phone           String?
  type            AuditorType
  position        String?
  organization    String?
  experience      String?
  status          AuditorStatus       @default(AVAILABLE)
  observations    String?
  createdById     String?
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User?               @relation("AuditorCreators", fields: [createdById], references: [id], onDelete: SetNull)
  competencies    AuditorCompetency[]
  teamMemberships AuditTeamMember[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([createdById])
}

model AuditorCompetency {
  id        String   @id @default(cuid())
  auditorId String
  name      String
  nameKey   String
  level     Int
  evidence  String?
  auditor   Auditor  @relation(fields: [auditorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auditorId, nameKey])
  @@index([auditorId])
}

model QualityDiagnostic {
  id                            String                         @id @default(cuid())
  companyId                     String
  title                         String
  description                   String
  status                        DiagnosticStatus               @default(DRAFT)
  createdById                   String
  company                       Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy                     User                           @relation("CreatedDiagnostics", fields: [createdById], references: [id], onDelete: Restrict)
  swotAnalysis                  SWOTAnalysis?
  aiAnalysis                    AIAnalysis?
  recommendations               Recommendation[]
  actionPlans                   ActionPlan[]
  crosses                       StrategicCross[]
  strategyWeightings            StrategyWeighting[]
  checkySessions                CheckySession[]
  strategicObjectives           StrategicObjective[]
  strategicObjectiveSuggestions StrategicObjectiveSuggestion[]
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  @@index([companyId])
  @@index([createdById])
  @@index([status])
}

model SWOTAnalysis {
  id           String            @id @default(cuid())
  diagnosticId String            @unique
  diagnostic   QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  items        SWOTItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model SWOTItem {
  id             String           @id @default(cuid())
  swotId         String
  type           SWOTType
  description    String
  priority       Priority?
  impact         Impact?
  swot           SWOTAnalysis     @relation(fields: [swotId], references: [id], onDelete: Cascade)
  factor1Crosses StrategicCross[] @relation("CrossFactor1")
  factor2Crosses StrategicCross[] @relation("CrossFactor2")
  createdAt      DateTime         @default(now())

  @@index([swotId])
  @@index([type])
}

model AIAnalysis {
  id                    String            @id @default(cuid())
  diagnosticId          String            @unique
  executiveSummary      String
  diagnosis             String
  keyFindings           Json
  foStrategies          Json
  doStrategies          Json
  faStrategies          Json
  daStrategies          Json
  priorityRisks         Json
  priorityOpportunities Json
  recommendations       Json
  /// Huella de los factores DOFA con los que se generó esta lectura. Es lo que permite distinguir una
  /// lectura vigente de otra que quedó atrás porque el usuario editó o eliminó factores después: la
  /// matriz DOFA es la fuente de verdad. Va en null en los análisis anteriores a esta columna, y un
  /// null no se puede comparar con nada, así que se trata como desactualizado en lugar de dar por
  /// bueno un análisis del que nadie sabe qué versión de la matriz leyó.
  swotFingerprint       String?
  diagnostic            QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model Recommendation {
  id              String               @id @default(cuid())
  diagnosticId    String
  title           String
  description     String
  priority        Priority
  expectedImpact  String
  suggestedAction String
  status          RecommendationStatus @default(PENDING)
  diagnostic      QualityDiagnostic    @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  actionItems     ActionItem[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([diagnosticId])
  @@index([status])
}

model ActionPlan {
  id                  String            @id @default(cuid())
  diagnosticId        String
  title               String
  description         String
  status              ActionPlanStatus  @default(DRAFT)
  createdById         String
  strategySource      String?
  strategySourceRef   String?
  strategyTitle       String?
  strategyDescription String?
  /**
   * Riesgo cuyo plan de mitigación ejecuta este plan de acción. Nullable y sin unicidad: un plan
   * puede existir sin estar vinculado (los planes de análisis estratégico, p. ej.) y un riesgo puede
   * acumular varios planes. El plan sobrevive a la baja del riesgo (SetNull), igual que el resto de
   * los enlaces débiles del proyecto: el diagnóstico al que pertenece no se toca.
   */
  riskId              String?
  diagnostic          QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  createdBy           User              @relation("CreatedActionPlans", fields: [createdById], references: [id], onDelete: Restrict)
  risk                Risk?             @relation(fields: [riskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items               ActionItem[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([diagnosticId, strategySource, strategySourceRef])
  @@index([diagnosticId])
  @@index([createdById])
  @@index([status])
  @@index([riskId])
}

model ActionItem {
  id               String           @id @default(cuid())
  actionPlanId     String
  recommendationId String?
  title            String
  description      String
  priority         Priority
  status           ActionItemStatus @default(PENDING)
  responsibleId    String?
  dueDate          DateTime?
  actionPlan       ActionPlan       @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  recommendation   Recommendation?  @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  responsible      User?            @relation("ResponsibleActionItems", fields: [responsibleId], references: [id], onDelete: SetNull)
  ticket           Ticket?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([actionPlanId])
  @@index([recommendationId])
  @@index([responsibleId])
  @@index([status])
}

model StrategicCross {
  id             String                   @id @default(cuid())
  diagnosticId   String
  crossType      CrossType
  origin         CrossOrigin              @default(USER)
  factor1Id      String
  factor2Id      String
  strategy       String?
  /**
   * Decisión tomada sobre la estrategia de este cruce en la pantalla de Checky. Reutiliza el mismo
   * enum que las sugerencias: null significa que todavía no se ha decidido, ACCEPTED es lo que
   * habilita la estrategia en Ponderación y REJECTED la deja fuera. Vive en el cruce y no en una
   * tabla nueva porque el cruce ya es la fuente de verdad de la pareja DOFA y de su estrategia.
   */
  strategyStatus CheckySuggestionStatus?
  aiAnalysis     Json?
  priority       Priority?
  createdById    String
  diagnostic     QualityDiagnostic        @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  factor1        SWOTItem                 @relation("CrossFactor1", fields: [factor1Id], references: [id], onDelete: Cascade)
  factor2        SWOTItem                 @relation("CrossFactor2", fields: [factor2Id], references: [id], onDelete: Cascade)
  createdBy      User                     @relation("CreatedStrategicCrosses", fields: [createdById], references: [id], onDelete: Restrict)
  weighting      StrategicCrossWeighting?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([factor1Id, factor2Id])
  @@index([diagnosticId])
  @@index([factor1Id])
  @@index([factor2Id])
}

model StrategicCrossWeighting {
  id                  String         @id @default(cuid())
  crossId             String         @unique
  impactoEstrategico  WeightingLevel
  viabilidad          WeightingLevel
  urgencia            WeightingLevel
  sinergiaInterna     WeightingLevel
  impactoReputacional WeightingLevel
  weightedScore       Float
  cross               StrategicCross @relation(fields: [crossId], references: [id], onDelete: Cascade)
  createdById         String
  createdBy           User           @relation("CreatedCrossWeightings", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([weightedScore])
  @@index([createdById])
}

/**
 * Ponderación de una estrategia que no es un cruce. La estrategia sigue viviendo donde nació —el
 * análisis con IA o una sugerencia aceptada de Checky— y aquí solo se guarda el valor que le dio el
 * usuario. sourceRef es el hash del texto normalizado, nunca un índice de posición, para que la
 * misma estrategia conserve su ponderación aunque cambie de fila dentro de la IA o de Checky.
 */
model StrategyWeighting {
  id                  String         @id @default(cuid())
  diagnosticId        String
  source              StrategySource
  sourceRef           String
  impactoEstrategico  WeightingLevel
  viabilidad          WeightingLevel
  urgencia            WeightingLevel
  sinergiaInterna     WeightingLevel
  impactoReputacional WeightingLevel
  weightedScore       Float
  createdById         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  diagnostic QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  createdBy  User              @relation("CreatedStrategyWeightings", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([diagnosticId, source, sourceRef])
  @@index([diagnosticId, weightedScore])
  @@index([createdById])
}

model CheckySession {
  id           String            @id @default(cuid())
  diagnosticId String
  title        String?
  diagnostic   QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  messages     CheckyMessage[]
  createdById  String
  createdBy    User              @relation("CreatedCheckySessions", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([diagnosticId])
  @@index([createdById])
}

model CheckyMessage {
  id                           String                  @id @default(cuid())
  sessionId                    String
  role                         CheckyMessageRole
  content                      String
  category                     CheckyCategory?
  basis                        CheckyFindingBasis?
  evidenceIds                  String[]                @default([])
  insufficientData             Boolean                 @default(false)
  missingInformation           String[]                @default([])
  status                       CheckySuggestionStatus?
  decisionNote                 String?
  suggestedStrategyTitle       String?
  suggestedStrategyDescription String?
  session                      CheckySession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt                    DateTime                @default(now())

  @@index([sessionId])
  @@index([status])
}

model StrategicObjective {
  id                 String                        @id @default(cuid())
  diagnosticId       String
  title              String
  statement          String
  specificCriteria   String?
  measurableCriteria String?
  achievableCriteria String?
  relevantCriteria   String?
  timeBoundCriteria  String?
  status             StrategicObjectiveStatus      @default(DRAFT)
  origin             StrategicObjectiveOrigin      @default(MANUAL)
  createdById        String
  diagnostic         QualityDiagnostic             @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  createdBy          User                          @relation("CreatedStrategicObjectives", fields: [createdById], references: [id], onDelete: Restrict)
  strategyLinks      StrategicObjectiveStrategy[]
  indicators         StrategicObjectiveIndicator[]
  history            StrategicObjectiveHistory[]
  acceptedSuggestion StrategicObjectiveSuggestion? @relation("AcceptedStrategicObjectiveSuggestion")
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@index([diagnosticId, status])
  @@index([createdById])
}

/**
 * Propuesta SMART persistida por Checky. La propuesta se mantiene separada del objetivo oficial
 * hasta que el usuario la acepte; así los estados de colaboración no se mezclan con DRAFT/APPROVED.
 * originalPayload nunca se actualiza; editablePayload contiene la última versión revisada por la
 * persona y ambos documentos comparten el mismo contrato validado por la aplicación.
 */
model StrategicObjectiveSuggestion {
  id                  String                 @id @default(cuid())
  diagnosticId        String
  requestedById       String
  originalPayload     Json
  editablePayload     Json
  strategyRefs        String[]               @default([])
  dedupeKey           String
  status              CheckySuggestionStatus @default(PENDING)
  decisionNote        String?
  acceptedObjectiveId String?                @unique
  decidedAt           DateTime?
  diagnostic          QualityDiagnostic      @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  requestedBy         User                   @relation("RequestedStrategicObjectiveSuggestions", fields: [requestedById], references: [id], onDelete: Restrict)
  acceptedObjective   StrategicObjective?    @relation("AcceptedStrategicObjectiveSuggestion", fields: [acceptedObjectiveId], references: [id], onDelete: SetNull)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([diagnosticId, dedupeKey])
  @@index([diagnosticId, status])
  @@index([requestedById])
}

model StrategicObjectiveStrategy {
  id                  String                           @id @default(cuid())
  objectiveId         String
  source              StrategicObjectiveStrategySource
  sourceRef           String
  strategyTitle       String
  strategyDescription String
  weightedScore       Float
  weightingBand       String
  linkedById          String
  objective           StrategicObjective               @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  linkedBy            User                             @relation("LinkedStrategicObjectiveStrategies", fields: [linkedById], references: [id], onDelete: Restrict)
  linkedAt            DateTime                         @default(now())

  @@unique([objectiveId, source, sourceRef])
  @@index([source, sourceRef])
  @@index([linkedById])
}

model StrategicObjectiveIndicator {
  id                   String             @id @default(cuid())
  objectiveId          String
  kpiId                String?
  name                 String?
  description          String?
  frequency            String?
  targetValue          String?
  formula              String?
  dataSource           String?
  unit                 String?
  reportResponsibleId  String?
  monitorResponsibleId String?
  greenThreshold       String?
  yellowThreshold      String?
  redThreshold         String?
  baselineValue        String?
  measurementMethod    String?
  deadline             DateTime?
  objective            StrategicObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  kpi                  Kpi?               @relation(fields: [kpiId], references: [id], onDelete: SetNull)
  reportResponsible    User?              @relation("ReportResponsibleStrategicObjectiveIndicators", fields: [reportResponsibleId], references: [id], onDelete: SetNull)
  monitorResponsible   User?              @relation("MonitorResponsibleStrategicObjectiveIndicators", fields: [monitorResponsibleId], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([deadline])
  @@index([kpiId])
  @@index([reportResponsibleId])
  @@index([monitorResponsibleId])
}

model StrategicObjectiveHistory {
  id          String                             @id @default(cuid())
  objectiveId String
  actorId     String?
  actorName   String?
  actorEmail  String?
  eventType   StrategicObjectiveHistoryEventType
  summary     String
  changes     Json?
  metadata    Json?
  occurredAt  DateTime                           @default(now())
  objective   StrategicObjective                 @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  actor       User?                              @relation("StrategicObjectiveHistoryActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([objectiveId, occurredAt])
  @@index([eventType])
  @@index([actorId])
}

model Process {
  id                     String                        @id @default(cuid())
  companyId              String
  name                   String
  code                   String?
  type                   ProcessType
  version                String?
  frequency              String?
  organizationalArea     String?
  supervision            String?
  executionType          String?
  objective              String
  description            String?
  responsibleId          String?
  status                 ProcessStatus                 @default(ACTIVE)
  thirdPartyProvided     Boolean                       @default(false)
  critical               Boolean                       @default(false)
  affectsAccounting      Boolean                       @default(false)
  personalData           Boolean                       @default(false)
  company                Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responsible            User?                         @relation("ResponsibleProcesses", fields: [responsibleId], references: [id], onDelete: SetNull)
  changeHistory          ProcessChange[]
  indicators             ProcessIndicator[]
  kpis                   Kpi[]
  kpiLinks               ProcessKpi[]
  sipocSuppliers         SipocSupplier[]
  sipocInputs            SipocInput[]
  sipocProcesses         SipocProcess[]
  sipocOutputs           SipocOutput[]
  sipocCustomers         SipocCustomer[]
  risks                  Risk[]
  procedures             Procedure[]
  audits                 Audit[]
  auditProcesses         AuditProcess[]
  auditPlanActivities    AuditPlanActivity[]
  auditProgramPriorities AuditProgramProcessPriority[]
  findingAudits          AuditFinding[]
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([type])
  @@index([responsibleId])
}

model ProcessIndicator {
  id                   String    @id @default(cuid())
  processId            String
  name                 String
  description          String
  frequency            String
  target               String
  formula              String
  dataSource           String
  unit                 String
  reportResponsibleId  String?
  monitorResponsibleId String?
  greenThreshold       String?
  yellowThreshold      String?
  redThreshold         String?
  baselineValue        String?
  measurementMethod    String?
  deadline             DateTime?
  process              Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  reportResponsible    User?     @relation("ReportResponsibleProcessIndicators", fields: [reportResponsibleId], references: [id], onDelete: SetNull)
  monitorResponsible   User?     @relation("MonitorResponsibleProcessIndicators", fields: [monitorResponsibleId], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([processId])
  @@index([deadline])
  @@index([reportResponsibleId])
  @@index([monitorResponsibleId])
}

model ProcessChange {
  id             String              @id @default(cuid())
  processId      String
  processName    String
  version        String
  action         ProcessChangeAction
  changedById    String?
  changes        Json
  changedAt      DateTime            @default(now())
  changedByName  String?
  changedByEmail String?
  process        Process             @relation(fields: [processId], references: [id], onDelete: Restrict)
  changedBy      User?               @relation("ProcessChangeActors", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([processId, changedAt])
  @@index([changedById])
}

/**
 * Indicador de catálogo. processId conserva el proceso propietario histórico; ProcessKpi contiene
 * las asociaciones reutilizables con procesos de la misma empresa.
 */
model Kpi {
  id                           String                        @id @default(cuid())
  processId                    String
  name                         String
  description                  String
  frequency                    String
  target                       String
  formula                      String
  dataSource                   String
  unit                         String
  reportResponsibleId          String?
  monitorResponsibleId         String?
  greenThreshold               String?
  yellowThreshold              String?
  redThreshold                 String?
  process                      Process                       @relation(fields: [processId], references: [id], onDelete: Cascade)
  reportResponsible            User?                         @relation("ReportResponsibleKpis", fields: [reportResponsibleId], references: [id], onDelete: SetNull)
  monitorResponsible           User?                         @relation("MonitorResponsibleKpis", fields: [monitorResponsibleId], references: [id], onDelete: SetNull)
  strategicObjectiveIndicators StrategicObjectiveIndicator[]
  processLinks                 ProcessKpi[]
  procedureLinks               ProcedureKpi[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@index([processId])
  @@index([reportResponsibleId])
  @@index([monitorResponsibleId])
}

/**
 * Relación explícita entre un KPI de empresa y los procesos que lo utilizan.
 */
model ProcessKpi {
  processId String
  kpiId     String
  process   Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  kpi       Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  linkedAt  DateTime @default(now())

  @@id([processId, kpiId])
  @@index([kpiId])
}

/**
 * Procedimiento documental de un proceso. La empresa se obtiene de process.companyId, igual que en
 * Kpi: no se duplica el tenant en dos columnas que podrían divergir. El código es único dentro del
 * proceso (índice) y la API además lo valida contra toda la empresa antes de crear o renombrar.
 */
model Procedure {
  id              String               @id @default(cuid())
  processId       String
  code            String
  name            String
  objective       String
  scope           String
  description     String?
  responsibleId   String?
  status          ProcedureStatus      @default(DRAFT)
  version         String               @default("1.0")
  process         Process              @relation(fields: [processId], references: [id], onDelete: Restrict)
  responsible     User?                @relation("ProcedureResponsibles", fields: [responsibleId], references: [id], onDelete: SetNull)
  kpis            ProcedureKpi[]
  steps           ProcedureStep[]
  indicators      ProcedureIndicator[]
  versions        ProcedureVersion[]
  auditProcedures AuditProcedure[]
  findingAudits   AuditFinding[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([processId, code])
  @@index([processId])
  @@index([status])
  @@index([responsibleId])
}

model ProcedureStep {
  id           String                     @id @default(cuid())
  procedureId  String
  position     Int
  title        String
  instruction  String
  criteria     String?
  procedure    Procedure                  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  responsibles ProcedureStepResponsible[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([procedureId, position])
  @@index([procedureId])
}

/**
 * Responsables activos asignados a una actividad concreta del procedimiento.
 */
model ProcedureStepResponsible {
  stepId String
  userId String
  step   ProcedureStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([stepId, userId])
  @@index([userId])
}

model ProcedureIndicator {
  id                   String    @id @default(cuid())
  procedureId          String
  name                 String
  description          String
  frequency            String
  target               String
  formula              String
  dataSource           String
  unit                 String
  reportResponsibleId  String?
  monitorResponsibleId String?
  greenThreshold       String?
  yellowThreshold      String?
  redThreshold         String?
  baselineValue        String?
  measurementMethod    String?
  deadline             DateTime?
  procedure            Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  reportResponsible    User?     @relation("ReportResponsibleProcedureIndicators", fields: [reportResponsibleId], references: [id], onDelete: SetNull)
  monitorResponsible   User?     @relation("MonitorResponsibleProcedureIndicators", fields: [monitorResponsibleId], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([procedureId])
  @@index([deadline])
  @@index([reportResponsibleId])
  @@index([monitorResponsibleId])
}

/**
 * Relación explícita entre un KPI de proceso y los procedimientos que lo utilizan.
 */
model ProcedureKpi {
  procedureId String
  kpiId       String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  kpi         Kpi       @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  linkedAt    DateTime  @default(now())

  @@id([procedureId, kpiId])
  @@index([kpiId])
}

/**
 * Historial de versiones de un procedimiento, append-only: cada alta, edición o cambio de estado
 * inserta una fila con el snapshot completo del contenido tras el hecho. No existe ningún endpoint
 * que actualice o borre filas (mismo contrato que ProcessChange): así una versión aprobada jamás se
 * sobrescribe y el historial sobrevive a la baja del procedimiento salvo que este nunca se aprobara.
 */
model ProcedureVersion {
  id             String                 @id @default(cuid())
  procedureId    String
  version        String
  status         ProcedureStatus
  action         ProcedureHistoryAction
  changes        Json?
  snapshot       Json?
  changedById    String?
  changedByName  String?
  changedByEmail String?
  changedAt      DateTime               @default(now())
  procedure      Procedure              @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  changedBy      User?                  @relation("ProcedureVersionActors", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([procedureId, changedAt])
  @@index([changedById])
}

model SipocSupplier {
