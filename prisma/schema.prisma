  auditPlanActivityAuditorAssignments            AuditPlanActivityAuditor[]            @relation("AuditPlanActivityAuditorAssigners")
  auditPlanActivityAuditorRemovals               AuditPlanActivityAuditor[]            @relation("AuditPlanActivityAuditorRemovers")
  auditPlansPrepared                             AuditPlan[]                           @relation("AuditPlanPreparers")
  auditPlansApproved                             AuditPlan[]                           @relation("AuditPlanApprovers")
  auditPlanActivityResponsibilities              AuditPlanActivity[]                   @relation("AuditPlanActivityResponsibles")
  auditPlanActivityStarts                        AuditPlanActivity[]                   @relation("AuditPlanActivityStarters")
  auditPlanActivityCompletions                   AuditPlanActivity[]                   @relation("AuditPlanActivityCompleters")
