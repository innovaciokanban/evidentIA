NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanban_consultoria"
PORT=4000
FRONTEND_URL="http://localhost:5173"
SESSION_COOKIE="kanban_session"
SESSION_DAYS=30
# IP hops del proxy reverso. Dejar 0 si no hay proxy. En producción detrás de
# Nginx/Caddy/Cloudflare: 1 por nivel de proxy (ajusta según tu infraestructura).
TRUST_PROXY_HOPS=0
SEED_PASSWORD="CambiarEstaClave123!"
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_API_KEY="sk-..."
# Proveedor de evidencias PDF. `local` conserva almacenamiento en disco; `r2` usa un bucket privado.
EVIDENCE_STORAGE_PROVIDER="local"
# R2/Cloudflare. Obligatorio cuando EVIDENCE_STORAGE_PROVIDER="r2".
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# R2_BUCKET="evidentia-evidence"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# Intervalo del worker server-side que revisa tickets vencidos.
# TICKET_NOTIFICATION_INTERVAL_MS="60000"
# Directorio privado (fuera de la raíz pública) donde se guardan los PDF de evidencia de los
# tickets de mitigación. En producción apúntalo a un volumen persistente, p. ej.
# /var/lib/evidentia/evidence, y respáldalo con el resto de datos de la aplicación.
EVIDENCE_UPLOAD_DIR="var/evidence"
